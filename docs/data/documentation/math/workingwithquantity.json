{"variants":[{"paths":["\/documentation\/math\/workingwithquantity"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"generated":true,"title":"Essentials","identifiers":["doc:\/\/Math\/documentation\/Math\/GettingStarted","doc:\/\/Math\/documentation\/Math\/StoringAndEncodingQuantities","doc:\/\/Math\/documentation\/Math\/UnitsByDimension","doc:\/\/Math\/documentation\/Math\/Quantity"],"anchor":"Essentials"}],"metadata":{"title":"Working with Quantity","roleHeading":"Article","role":"article","modules":[{"name":"Math"}]},"kind":"article","schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"identifier":{"url":"doc:\/\/Math\/documentation\/Math\/WorkingWithQuantity","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/Quantity"},{"type":"text","text":" is the type you’ll reach for most often. It works the way"},{"type":"text","text":" "},{"type":"text","text":"Foundation’s "},{"type":"codeVoice","code":"Measurement"},{"type":"text","text":" does, but with compile-time dimension checking: a"},{"type":"text","text":" "},{"type":"text","text":"quantity always knows its unit, and its unit knows its "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/PhysicalDimension"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This article covers everything you can do with a quantity, grouped the same way"},{"type":"text","text":" "},{"type":"text","text":"Apple documents its own value types."}]},{"level":3,"type":"heading","text":"Create a Quantity","anchor":"Create-a-Quantity"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a quantity with a value and a unit using"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/Quantity\/init(value:unit:)"},{"type":"text","text":":"}]},{"syntax":"swift","code":["import Math","","\/\/ Distance","let jumpLength = Quantity(value: 8.95, unit: Units.meter)","","\/\/ Money — currency units place their symbol before the value ($8.95)","let price = Quantity(value: 8.95, unit: Units.usd)","","\/\/ Temperature — offset units like Celsius convert correctly","let bodyTemp = Quantity(value: 37.0, unit: Units.celsius)"],"type":"codeListing"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The value is a "},{"type":"codeVoice","code":"Double"},{"type":"text","text":", so you can pass integer literals directly:"},{"type":"text","text":" "},{"type":"codeVoice","code":"Quantity(value: 42, unit: Units.kilometer)"},{"type":"text","text":"."}]}],"type":"aside","style":"note","name":"Note"},{"level":3,"type":"heading","text":"Convert Between Units","anchor":"Convert-Between-Units"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/Quantity\/converted(to:)"},{"type":"text","text":" to convert to another unit of the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"same"}]},{"type":"text","text":" "},{"type":"text","text":"dimension. The framework converts through the unit’s base unit, so arbitrary"},{"type":"text","text":" "},{"type":"text","text":"chains like "},{"type":"codeVoice","code":"nanometer → kilometer"},{"type":"text","text":" just work:"}]},{"syntax":"swift","code":["let chipFeature = Quantity(value: 5.0, unit: Units.nanometer)","let inMeters = chipFeature.converted(to: Units.meter)","print(inMeters.value) \/\/ 5e-09","","let marathon = Quantity(value: 42.195, unit: Units.kilometer)","print(marathon.converted(to: Units.mile).value) \/\/ 26.218...","","let paycheck = Quantity(value: 100.0, unit: Units.eur)","print(paycheck.converted(to: Units.usd).value) \/\/ 108.0"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Because conversions require matching dimensions, converting a "},{"type":"codeVoice","code":"length"},{"type":"text","text":" to a"},{"type":"text","text":" "},{"type":"codeVoice","code":"time"},{"type":"text","text":" doesn’t compile (or traps at runtime if the units are fully dynamic)."},{"type":"text","text":" "},{"type":"text","text":"See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/CompileTimeSafety"},{"type":"text","text":" for details."}]},{"level":3,"type":"heading","text":"Compare Quantities","anchor":"Compare-Quantities"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Quantities of the same unit type compare by their values with "},{"type":"codeVoice","code":"=="},{"type":"text","text":". To compare"},{"type":"text","text":" "},{"type":"text","text":"quantities expressed in "},{"type":"emphasis","inlineContent":[{"type":"text","text":"different"}]},{"type":"text","text":" units of the same dimension—or to allow a"},{"type":"text","text":" "},{"type":"text","text":"small tolerance—use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/Quantity\/isEquivalent(to:tolerance:)"},{"type":"text","text":":"}]},{"syntax":"swift","code":["let oneMile = Quantity(value: 1.0, unit: Units.mile)","let oneKm    = Quantity(value: 1.0, unit: Units.kilometer)","","oneMile.isEquivalent(to: Quantity(value: 1609.344, unit: Units.meter)) \/\/ true","oneMile.isEquivalent(to: oneKm)                                        \/\/ false"],"type":"codeListing"},{"level":3,"type":"heading","text":"Add and Subtract Quantities","anchor":"Add-and-Subtract-Quantities"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can add and subtract quantities of the same dimension even when their units"},{"type":"text","text":" "},{"type":"text","text":"differ. The result keeps the left-hand side’s unit; the right-hand side is"},{"type":"text","text":" "},{"type":"text","text":"converted automatically:"}]},{"syntax":"swift","code":["let dish = Quantity(value: 1.5, unit: Units.kilogram)","let spice = Quantity(value: 350.0, unit: Units.gram)","","let total = dish + spice","print(total) \/\/ 1.85 kg"],"type":"codeListing"},{"level":3,"type":"heading","text":"Multiply and Divide Quantities","anchor":"Multiply-and-Divide-Quantities"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Multiplying or dividing two quantities combines their dimensions and produces a"},{"type":"text","text":" "},{"type":"text","text":"new "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/CompositeUnit"},{"type":"text","text":". The framework adjusts both the numeric value and the"},{"type":"text","text":" "},{"type":"text","text":"coefficient so results stay physically correct:"}]},{"syntax":"swift","code":["let area = Quantity(value: 3.0, unit: Units.meter) * Quantity(value: 2.0, unit: Units.meter)","print(area.value)          \/\/ 6.0","print(area.unit.symbol)    \/\/ \"(m*m)\"","print(area.unit.dimension) \/\/ area","","let speed = Quantity(value: 100.0, unit: Units.meter) \/ Quantity(value: 5.0, unit: Units.second)","print(speed.value)          \/\/ 20.0","print(speed.unit.symbol)    \/\/ \"(m\/s)\"","print(speed.unit.dimension) \/\/ speed"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can also multiply and divide a quantity by a plain "},{"type":"codeVoice","code":"Double"},{"type":"text","text":" scalar, which"},{"type":"text","text":" "},{"type":"text","text":"keeps the same unit:"}]},{"syntax":"swift","code":["let doubling = Quantity(value: 5.0, unit: Units.meter) * 2","print(doubling) \/\/ 10.00 m"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For common derived dimensions, "},{"type":"codeVoice","code":"Math"},{"type":"text","text":" produces cleaner units. For example,"},{"type":"text","text":" "},{"type":"text","text":"multiplying a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension\/power"},{"type":"text","text":" by a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension\/time"},{"type":"text","text":" yields an"},{"type":"text","text":" "},{"type":"text","text":"energy unit with the conventional symbol ordering:"}]},{"syntax":"swift","code":["let power   = Quantity(value: 2.0, unit: Units.kilowatt)","let runTime = Quantity(value: 3.0, unit: Units.hour)","let energy  = power * runTime    \/\/ 6 kWh, dimension = energy"],"type":"codeListing"},{"level":3,"type":"heading","text":"Format Quantities","anchor":"Format-Quantities"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/Quantity"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"CustomStringConvertible"},{"type":"text","text":", so it prints a formatted"},{"type":"text","text":" "},{"type":"text","text":"string automatically. Use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/Quantity\/formatted(decimalPlaces:includeSpace:)"},{"type":"text","text":" "},{"type":"text","text":"to control the decimal places and spacing. Currency symbols are placed before"},{"type":"text","text":" "},{"type":"text","text":"the value by default; most other symbols follow it:"}]},{"syntax":"swift","code":["let tenDollars = Quantity(value: 10.1234, unit: Units.usd)","print(tenDollars.formatted())                 \/\/ \"$10.12\"","print(tenDollars.formatted(decimalPlaces: 3)) \/\/ \"$10.123\"","","let fiveMeters = Quantity(value: 5.5, unit: Units.meter)","print(fiveMeters.formatted())                 \/\/ \"5.50 m\"","print(fiveMeters.formatted(includeSpace: false)) \/\/ \"5.50m\"","","let percent = Quantity(value: 75.5, unit: Units.percent)","print(percent.formatted())                    \/\/ \"75.5%\""],"type":"codeListing"},{"level":3,"type":"heading","text":"What’s Next?","anchor":"Whats-Next"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Browse the ready-made units in "},{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/Units","isActive":true},{"type":"text","text":" or define your own named units with"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/NamedUnit","isActive":true},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Build composite units dynamically by combining units with the "},{"type":"codeVoice","code":"*"},{"type":"text","text":" and "},{"type":"codeVoice","code":"\/"},{"type":"text","text":" "},{"type":"text","text":"operators defined for "},{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/MathUnit","isActive":true},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Read "},{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/CustomDimensions","isActive":true},{"type":"text","text":" to define units for your own domain."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Read "},{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/CompileTimeSafety","isActive":true},{"type":"text","text":" to make dimension correctness a compile-time"},{"type":"text","text":" "},{"type":"text","text":"guarantee."}]}]}]}]}],"abstract":[{"text":"Create, convert, compare, compute with, and format ","type":"text"},{"identifier":"doc:\/\/Math\/documentation\/Math\/Quantity","type":"reference","isActive":true},{"text":" values in your app.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/Math\/documentation\/Math"]]},"references":{"doc://Math/documentation/Math/Quantity/init(value:unit:)":{"type":"topic","title":"init(value:unit:)","url":"\/docume