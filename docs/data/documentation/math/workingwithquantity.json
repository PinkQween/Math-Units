{"kind":"article","schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Math\/documentation\/Math\/WorkingWithQuantity"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/math\/workingwithquantity"]}],"sections":[],"metadata":{"modules":[{"name":"Math"}],"roleHeading":"Article","role":"article","title":"Working with Quantity"},"abstract":[{"text":"Create, convert, compare, compute with, and format ","type":"text"},{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/Quantity","isActive":true},{"text":" values in your app.","type":"text"}],"seeAlsoSections":[{"identifiers":["doc:\/\/Math\/documentation\/Math\/GettingStarted","doc:\/\/Math\/documentation\/Math\/Quantity"],"anchor":"Essentials","title":"Essentials","generated":true}],"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"inlineContent":[{"identifier":"doc:\/\/Math\/documentation\/Math\/Quantity","type":"reference","isActive":true},{"text":" is the type you’ll reach for most often. It works the way","type":"text"},{"text":" ","type":"text"},{"text":"Foundation’s ","type":"text"},{"type":"codeVoice","code":"Measurement"},{"text":" does, but with compile-time dimension checking: a","type":"text"},{"text":" ","type":"text"},{"text":"quantity always knows its unit, and its unit knows its ","type":"text"},{"identifier":"doc:\/\/Math\/documentation\/Math\/PhysicalDimension","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This article covers everything you can do with a quantity, grouped the same way","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Apple documents its own value types."}],"type":"paragraph"},{"text":"Create a Quantity","type":"heading","level":3,"anchor":"Create-a-Quantity"},{"inlineContent":[{"type":"text","text":"Create a quantity with a value and a unit using"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Math\/documentation\/Math\/Quantity\/init(value:unit:)","isActive":true,"type":"reference"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import Math","","\/\/ Distance","let jumpLength = Quantity(value: 8.95, unit: Units.meter)","","\/\/ Money — currency units place their symbol before the value ($8.95)","let price = Quantity(value: 8.95, unit: Units.usd)","","\/\/ Temperature — offset units like Celsius convert correctly","let bodyTemp = Quantity(value: 37.0, unit: Units.celsius)"]},{"name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The value is a "},{"type":"codeVoice","code":"Double"},{"type":"text","text":", so you can pass integer literals directly:"},{"type":"text","text":" "},{"type":"codeVoice","code":"Quantity(value: 42, unit: Units.kilometer)"},{"type":"text","text":"."}]}],"style":"note","type":"aside"},{"anchor":"Convert-Between-Units","text":"Convert Between Units","type":"heading","level":3},{"inlineContent":[{"text":"Use ","type":"text"},{"identifier":"doc:\/\/Math\/documentation\/Math\/Quantity\/converted(to:)","isActive":true,"type":"reference"},{"text":" to convert to another unit of the ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"same"}]},{"text":" ","type":"text"},{"text":"dimension. The framework converts through the unit’s base unit, so arbitrary","type":"text"},{"type":"text","text":" "},{"text":"chains like ","type":"text"},{"type":"codeVoice","code":"nanometer → kilometer"},{"type":"text","text":" just work:"}],"type":"paragraph"},{"type":"codeListing","code":["let chipFeature = Quantity(value: 5.0, unit: Units.nanometer)","let inMeters = chipFeature.converted(to: Units.meter)","print(inMeters.value) \/\/ 5e-09","","let marathon = Quantity(value: 42.195, unit: Units.kilometer)","print(marathon.converted(to: Units.mile).value) \/\/ 26.218...","","let paycheck = Quantity(value: 100.0, unit: Units.eur)","print(paycheck.converted(to: Units.usd).value) \/\/ 108.0"],"syntax":"swift"},{"inlineContent":[{"text":"Because conversions require matching dimensions, converting a ","type":"text"},{"code":"length","type":"codeVoice"},{"text":" to a","type":"text"},{"text":" ","type":"text"},{"code":"time","type":"codeVoice"},{"text":" doesn’t compile (or traps at runtime if the units are fully dynamic).","type":"text"},{"text":" ","type":"text"},{"text":"See ","type":"text"},{"identifier":"doc:\/\/Math\/documentation\/Math\/CompileTimeSafety","isActive":true,"type":"reference"},{"text":" for details.","type":"text"}],"type":"paragraph"},{"anchor":"Compare-Quantities","text":"Compare Quantities","level":3,"type":"heading"},{"inlineContent":[{"text":"Quantities of the same unit type compare by their values with ","type":"text"},{"code":"==","type":"codeVoice"},{"text":". To compare","type":"text"},{"text":" ","type":"text"},{"text":"quantities expressed in ","type":"text"},{"inlineContent":[{"text":"different","type":"text"}],"type":"emphasis"},{"text":" units of the same dimension—or to allow a","type":"text"},{"text":" ","type":"text"},{"text":"small tolerance—use ","type":"text"},{"identifier":"doc:\/\/Math\/documentation\/Math\/Quantity\/isEquivalent(to:tolerance:)","isActive":true,"type":"reference"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","code":["let oneMile = Quantity(value: 1.0, unit: Units.mile)","let oneKm    = Quantity(value: 1.0, unit: Units.kilometer)","","oneMile.isEquivalent(to: Quantity(value: 1609.344, unit: Units.meter)) \/\/ true","oneMile.isEquivalent(to: oneKm)                                        \/\/ false"],"syntax":"swift"},{"anchor":"Add-and-Subtract-Quantities","text":"Add and Subtract Quantities","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"You can add and subtract quantities of the same dimension even when their units"},{"type":"text","text":" "},{"type":"text","text":"differ. The result keeps the left-hand side’s unit; the right-hand side is"},{"type":"text","text":" "},{"type":"text","text":"converted automatically:"}],"type":"paragraph"},{"type":"codeListing","code":["let dish = Quantity(value: 1.5, unit: Units.kilogram)","let spice = Quantity(value: 350.0, unit: Units.gram)","","let total = dish + spice","print(total) \/\/ 1.85 kg"],"syntax":"swift"},{"anchor":"Multiply-and-Divide-Quantities","text":"Multiply and Divide Quantities","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Multiplying or dividing two quantities combines their dimensions and produces a"},{"type":"text","text":" "},{"type":"text","text":"new "},{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/CompositeUnit","isActive":true},{"type":"text","text":". The framework adjusts both the numeric value and the"},{"type":"text","text":" "},{"type":"text","text":"coefficient so results stay physically correct:"}],"type":"paragraph"},{"type":"codeListing","code":["let area = Quantity(value: 3.0, unit: Units.meter) * Quantity(value: 2.0, unit: Units.meter)","print(area.value)          \/\/ 6.0","print(area.unit.symbol)    \/\/ \"(m*m)\"","print(area.unit.dimension) \/\/ area","","let speed = Quantity(value: 100.0, unit: Units.meter) \/ Quantity(value: 5.0, unit: Units.second)","print(speed.value)          \/\/ 20.0","print(speed.unit.symbol)    \/\/ \"(m\/s)\"","print(speed.unit.dimension) \/\/ speed"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"You can also multiply and divide a quantity by a plain "},{"type":"codeVoice","code":"Double"},{"text":" scalar, which","type":"text"},{"text":" ","type":"text"},{"text":"keeps the same unit:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["let doubling = Quantity(value: 5.0, unit: Units.meter) * 2","print(doubling) \/\/ 10.00 m"],"syntax":"swift"},{"inlineContent":[{"text":"For common derived dimensions, ","type":"text"},{"type":"codeVoice","code":"Math"},{"text":" produces cleaner units. For example,","type":"text"},{"text":" ","type":"text"},{"text":"multiplying a ","type":"text"},{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension\/power","isActive":true},{"text":" by a ","type":"text"},{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension\/time","isActive":true},{"text":" yields an","type":"text"},{"text":" ","type":"text"},{"text":"energy unit with the conventional symbol ordering:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let power   = Quantity(value: 2.0, unit: Units.kilowatt)","let runTime = Quantity(value: 3.0, unit: Units.hour)","let energy  = power * runTime    \/\/ 6 kWh, dimension = energy"]},{"level":3,"type":"heading","text":"Format Quantities","anchor":"Format-Quantities"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/Quantity","isActive":true},{"text":" conforms to ","type":"text"},{"type":"codeVoice","code":"CustomStringConvertible"},{"text":", so it prints a formatted","type":"text"},{"text":" ","type":"text"},{"text":"string automatically. Use ","type":"text"},{"identifier":"doc:\/\/Math\/documentation\/Math\/Quantity\/formatted(decimalPlaces:includeSpace:)","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"to control the decimal places and spacing. Currency symbols are placed before","type":"text"},{"text":" ","type":"text"},{"text":"the value by default; most other symbols follow it:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let tenDollars = Quantity(value: 10.1234, unit: Units.usd)","print(tenDollars.formatted())                 \/\/ \"$10.12\"","print(tenDollars.formatted(decimalPlaces: 3)) \/\/ \"$10.123\"","","let fiveMeters = Quantity(value: 5.5, unit: Units.meter)","print(fiveMeters.formatted())                 \/\/ \"5.50 m\"","print(fiveMeters.formatted(includeSpace: false)) \/\/ \"5.5