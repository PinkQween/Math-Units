s"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can add and subtract quantities of the same dimension even when their units"},{"type":"text","text":" "},{"type":"text","text":"differ. The result keeps the left-hand side’s unit; the right-hand side is"},{"type":"text","text":" "},{"type":"text","text":"converted automatically:"}]},{"syntax":"swift","type":"codeListing","code":["let dish = Quantity(value: 1.5, unit: Units.kilogram)","let spice = Quantity(value: 350.0, unit: Units.gram)","","let total = dish + spice","print(total) \/\/ 1.85 kg"]},{"level":3,"text":"Multiply and Divide Quantities","type":"heading","anchor":"Multiply-and-Divide-Quantities"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Multiplying or dividing two quantities combines their dimensions and produces a"},{"type":"text","text":" "},{"type":"text","text":"new "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/CompositeUnit"},{"type":"text","text":". The framework adjusts both the numeric value and the"},{"type":"text","text":" "},{"type":"text","text":"coefficient so results stay physically correct:"}]},{"syntax":"swift","type":"codeListing","code":["let area = Quantity(value: 3.0, unit: Units.meter) * Quantity(value: 2.0, unit: Units.meter)","print(area.value)          \/\/ 6.0","print(area.unit.symbol)    \/\/ \"(m*m)\"","print(area.unit.dimension) \/\/ area","","let speed = Quantity(value: 100.0, unit: Units.meter) \/ Quantity(value: 5.0, unit: Units.second)","print(speed.value)          \/\/ 20.0","print(speed.unit.symbol)    \/\/ \"(m\/s)\"","print(speed.unit.dimension) \/\/ speed"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can also multiply and divide a quantity by a plain "},{"code":"Double","type":"codeVoice"},{"type":"text","text":" scalar, which"},{"type":"text","text":" "},{"type":"text","text":"keeps the same unit:"}]},{"syntax":"swift","type":"codeListing","code":["let doubling = Quantity(value: 5.0, unit: Units.meter) * 2","print(doubling) \/\/ 10.00 m"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For common derived dimensions, "},{"code":"Math","type":"codeVoice"},{"type":"text","text":" produces cleaner units. For example,"},{"type":"text","text":" "},{"type":"text","text":"multiplying a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension\/power"},{"type":"text","text":" by a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension\/time"},{"type":"text","text":" yields an"},{"type":"text","text":" "},{"type":"text","text":"energy unit with the conventional symbol ordering:"}]},{"syntax":"swift","type":"codeListing","code":["let power   = Quantity(value: 2.0, unit: Units.kilowatt)","let runTime = Quantity(value: 3.0, unit: Units.hour)","let energy  = power * runTime    \/\/ 6 kWh, dimension = energy"]},{"level":3,"text":"Format Quantities","type":"heading","anchor":"Format-Quantities"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/Quantity"},{"type":"text","text":" conforms to "},{"code":"CustomStringConvertible","type":"codeVoice"},{"type":"text","text":", so it prints a formatted"},{"type":"text","text":" "},{"type":"text","text":"string automatically. Use "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/Quantity\/formatted(decimalPlaces:includeSpace:)"},{"type":"text","text":" "},{"type":"text","text":"to control the decimal places and spacing. Currency symbols are placed before"},{"type":"text","text":" "},{"type":"text","text":"the value by default; most other symbols follow it:"}]},{"syntax":"swift","type":"codeListing","code":["let tenDollars = Quantity(value: 10.1234, unit: Units.usd)","print(tenDollars.formatted())                 \/\/ \"$10.12\"","print(tenDollars.formatted(decimalPlaces: 3)) \/\/ \"$10.123\"","","