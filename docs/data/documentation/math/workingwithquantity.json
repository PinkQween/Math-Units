{"metadata":{"roleHeading":"Article","title":"Working with Quantity","modules":[{"name":"Math"}],"role":"article"},"schemaVersion":{"major":0,"minor":3,"patch":0},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/Math\/documentation\/Math\/GettingStarted","doc:\/\/Math\/documentation\/Math\/StoringAndEncodingQuantities","doc:\/\/Math\/documentation\/Math\/UnitsByDimension","doc:\/\/Math\/documentation\/Math\/Quantity"],"anchor":"Essentials","title":"Essentials"}],"variants":[{"paths":["\/documentation\/math\/workingwithquantity"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/Math\/documentation\/Math\/WorkingWithQuantity","interfaceLanguage":"swift"},"sections":[],"abstract":[{"type":"text","text":"Create, convert, compare, compute with, and format "},{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/Quantity","isActive":true},{"type":"text","text":" values in your app."}],"hierarchy":{"paths":[["doc:\/\/Math\/documentation\/Math"]]},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/Quantity"},{"type":"text","text":" is the type you’ll reach for most often. It works the way"},{"type":"text","text":" "},{"type":"text","text":"Foundation’s "},{"type":"codeVoice","code":"Measurement"},{"type":"text","text":" does, but with compile-time dimension checking: a"},{"type":"text","text":" "},{"type":"text","text":"quantity always knows its unit, and its unit knows its "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/PhysicalDimension"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This article covers everything you can do with a quantity, grouped the same way"},{"type":"text","text":" "},{"type":"text","text":"Apple documents its own value types."}]},{"type":"heading","level":3,"text":"Create a Quantity","anchor":"Create-a-Quantity"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a quantity with a value and a unit using"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/Quantity\/init(value:unit:)"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["import Math","","\/\/ Distance","let jumpLength = Quantity(value: 8.95, unit: Units.meter)","","\/\/ Money — currency units place their symbol before the value ($8.95)","let price = Quantity(value: 8.95, unit: Units.usd)","","\/\/ Temperature — offset units like Celsius convert correctly","let bodyTemp = Quantity(value: 37.0, unit: Units.celsius)"]},{"type":"aside","style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The value is a "},{"code":"Double","type":"codeVoice"},{"type":"text","text":", so you can pass integer literals directly:"},{"type":"text","text":" "},{"code":"Quantity(value: 42, unit: Units.kilometer)","type":"codeVoice"},{"type":"text","text":"."}]}]},{"type":"heading","level":3,"text":"Convert Between Units","anchor":"Convert-Between-Units"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/Quantity\/converted(to:)"},{"type":"text","text":" to convert to another unit of the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"same"}]},{"type":"text","text":" "},{"type":"text","text":"dimension. The framework converts through the unit’s base unit, so arbitrary"},{"type":"text","text":" "},{"type":"text","text":"chains like "},{"type":"codeVoice","code":"nanometer → kilometer"},{"type":"text","text":" just work:"}]},{"code":["let chipFeature = Quantity(value: 5.0, unit: Units.nanometer)","let inMeters = chipFeature.converted(to: Units.meter)","print(inMeters.value) \/\/ 5e-09","","let marathon = Quantity(value: 42.195, unit: Units.kilometer)","print(marathon.converted(to: Units.mile).value) \/\/ 26.218...","","let paycheck = Quantity(value: 100.0, unit: Units.eur)","print(paycheck.converted(to: Units.usd).value) \/\/ 108.0"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Because conversions require matching dimensions, converting a "},{"code":"length","type":"codeVoice"},{"type":"text","text":" to a"},{"type":"text","text":" "},{"code":"time","type":"codeVoice"},{"type":"text","text":" doesn’t compile (or traps at runtime if the units are fully dynamic)."},{"type":"text","text":" "},{"type":"text","text":"See "},{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/CompileTimeSafety","isActive":true},{"type":"text","text":" for details."}],"type":"paragraph"},{"text":"Compare Quantities","type":"heading","level":3,"anchor":"Compare-Quantities"},{"inlineContent":[{"type":"text","text":"Quantities of the same unit type compare by their values with "},{"code":"==","type":"codeVoice"},{"type":"text","text":". To compare"},{"type":"text","text":" "},{"type":"text","text":"quantities expressed in "},{"type":"emphasis","inlineContent":[{"text":"different","type":"text"}]},{"type":"text","text":" units of the same dimension—or to allow a"},{"type":"text","text":" "},{"type":"text","text":"small tolerance—use "},{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/Quantity\/isEquivalent(to:tolerance:)","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"code":["let oneMile = Quantity(value: 1.0, unit: Units.mile)","let oneKm    = Quantity(value: 1.0, unit: Units.kilometer)","","oneMile.isEquivalent(to: Quantity(value: 1609.344, unit: Units.meter)) \/\/ true","oneMile.isEquivalent(to: oneKm)                                        \/\/ false"],"syntax":"swift","type":"codeListing"},{"text":"Add and Subtract Quantities","type":"heading","level":3,"anchor":"Add-and-Subtract-Quantities"},{"inlineContent":[{"type":"text","text":"You can add and subtract quantities of the same dimension even when their units"},{"type":"text","text":" "},{"type":"text","text":"differ. The result keeps the left-hand side’s unit; the right-hand side is"},{"type":"text","text":" "},{"type":"text","text":"converted automatically:"}],"type":"paragraph"},{"code":["let dish = Quantity(value: 1.5, unit: Units.kilogram)","let spice = Quantity(value: 350.0, unit: Units.gram)","","let total = dish + spice","print(total) \/\/ 1.85 kg"],"type":"codeListing","syntax":"swift"},{"text":"Multiply and Divide Quantities","type":"heading","level":3,"anchor":"Multiply-and-Divide-Quantities"},{"inlineContent":[{"type":"text","text":"Multiplying or dividing two quantities combines their dimensions and produces a"},{"type":"text","text":" "},{"type":"text","text":"new "},{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/CompositeUnit","isActive":true},{"type":"text","text":". The framework adjusts both the numeric value and the"},{"type":"text","text":" "},{"type":"text","text":"coefficient so results stay physically correct:"}],"type":"paragraph"},{"code":["let area = Quantity(value: 3.0, unit: Units.meter) * Quantity(value: 2.0, unit: Units.meter)","print(area.value)          \/\/ 6.0","print(area.unit.symbol)    \/\/ \"(m*m)\"","print(area.unit.dimension) \/\/ area","","let speed = Quantity(value: 100.0, unit: Units.meter) \/ Quantity(value: 5.0, unit: Units.second)","print(speed.value)          \/\/ 20.0","print(speed.unit.symbol)    \/\/ \"(m\/s)\"","print(speed.unit.dimension) \/\/ speed"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"You can also multiply and divide a quantity by a plain ","type":"text"},{"code":"Double","type":"codeVoice"},{"text":" scalar, which","type":"text"},{"text":" ","type":"text"},{"text":"keeps the same unit:","type":"text"}],"type":"paragraph"},{"code":["let doubling = Quantity(value: 5.0, unit: Units.meter) * 2","print(doubling) \/\/ 10.00 m"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"For common derived dimensions, ","type":"text"},{"type":"codeVoice","code":"Math"},{"text":" produces cleaner units. For example,","type":"text"},{"text":" ","type":"text"},{"text":"multiplying a ","type":"text"},{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension\/power","isActive":true},{"text":" by a ","type":"text"},{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension\/time","isActive":true},{"type":"text","text":" yields an"},{"type":"text","text":" "},{"type":"text","text":"energy unit with the conventional symbol ordering:"}],"type":"paragraph"},{"code":["let power   = Quantity(value: 2.0, unit: Units.kilowatt)","let runTime = Quantity(value: 3.0, unit: Units.hour)","let energy  = power * runTime    \/\/ 6 kWh, dimension = energy"],"type":"codeListing","syntax":"swift"},{"text":"Format Quantities","type":"heading","level":3,"anchor":"Format-Quantities"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/Quantity","isActive":true},{"type":"text","text":" conforms to "},{"code":"CustomStringConvertible","type":"codeVoice"},{"type":"text","text":", so it prints a formatted"},{"type":"text","text":" "},{"type":"text","text":"string automatically. Use "},{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/Quantity\/formatted(decimalPlaces:includeSpace:)","isActive":true},{"type":"text","text":" "},{"type":"text","text":"to control the decimal places and spacing. Currency symbols are placed before"},{"type":"text","text":" "},{"type":"text","text":"the value by default; most other symbols follow it:"}],"type":"paragraph"},{"code":["let tenDollars = Quantity(value: 10.1234, unit: Units.usd)","print(tenDollars.formatted())                 \/\/ \"$10.12\"","print(tenDollars.formatted(decimalPlaces: 3)) \/\/ \"$10.123\"","","let fiveMeters = Quantity(value: 5.5, unit: Units.meter)","print(fiveMeters.formatted())                 \/\/ \"5.50 m\"","print(fiveMeters.formatted(includeSpace: false)) \/\/ \"5.50m\"","","let percent = Quantity(value: 75.5, unit: Units.percent)","print(percent.formatted())                    \/\/ \"75.5%\""],"type":"codeListing","syntax":"swift"},{"text":"What’s Next?","type":"heading","level":3,"anchor":"Whats-Next"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Browse the ready-made units in ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/Units"},{"text":" or define your own named units with","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/NamedUnit"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Build composite units dynamically by combining units with the ","type":"text"},{"code":"*","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"\/","type":"codeVoice"},{"text":" ","type":"text"},{"text":"operators defined for ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/MathUnit"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Read ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/CustomDimensions"},{"text":" to define units for your own domain.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Read ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/CompileTimeSafety"},{"text":" to make dimension correctness a compile-time","type":"text"},{"text":" ","type":"text"},{"text":"guarantee.","type":"text"}]}]}]}]}],"kind":"article","references":{"doc://Math/documentation/Math/PhysicalDimension":{"url":"\/documentation\/math\/physicaldimension","abstract":[{"text