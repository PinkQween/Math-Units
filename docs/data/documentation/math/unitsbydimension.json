a"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"data"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"byte"},{"text":", ","type":"text"},{"type":"codeVoice","code":"gibibyte"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/Units\/Energy"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"energy"}],"type":"paragraph"}],[{"inlineContent":[{"code":"kelvin","type":"codeVoice"},{"text":", ","type":"text"},{"code":"joule","type":"codeVoice"},{"text":", ","type":"text"},{"code":"calorie","type":"codeVoice"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/Units\/Currency"}]}],[{"type":"paragraph","inlineContent":[{"code":"currency","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"usd","type":"codeVoice"},{"text":", ","type":"text"},{"code":"eur","type":"codeVoice"},{"type":"text","text":", "},{"code":"btc","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"…and more","type":"text"}]}],[{"inlineContent":[{"type":"text","text":"…"}],"type":"paragraph"}],[{"inlineContent":[{"text":"…","type":"text"}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"text":"Each namespace also exposes ","type":"text"},{"type":"codeVoice","code":"all"},{"text":", an array of every base unit in its dimension,","type":"text"},{"text":" ","type":"text"},{"text":"which is handy for building menus and pickers:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["for unit in Units.Volume.all {","    print(unit.symbol)","}"]},{"level":4,"type":"heading","text":"Currency common names","anchor":"Currency-common-names"},{"type":"paragraph","inlineContent":[{"text":"The currency dimension is special: most names are only meaningful with their","type":"text"},{"text":" ","type":"text"},{"text":"country code, so the explicit spellings stay (","type":"text"},{"code":"Units.usd","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Units.cad","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"Units.currency.mxn","type":"codeVoice"},{"text":", …). Currencies whose common name is unambiguous get","type":"text"},{"text":" ","type":"text"},{"text":"colloquial aliases in every access style — ","type":"text"},{"code":"Units.pounds","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Units.Currency.sterling","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"code":"Quantity(value: 100, unit: .poundsSterling)","type":"codeVoice"},{"text":" all refer to the British pound","type":"text"},{"text":" ","type":"text"},{"text":"(GBP), ","type":"text"},{"code":".yen","type":"codeVoice"},{"text":" to JPY, ","type":"text"},{"code":".franc","type":"codeVoice"},{"text":" to CHF, ","type":"text"},{"code":".rupee","type":"codeVoice"},{"text":" to INR, and so on. There is","type":"text"},{"text":" ","type":"text"},{"text":"deliberately no bare ","type":"text"},{"code":".dollar","type":"codeVoice"},{"text":" or ","type":"text"},{"type":"codeVoice","code":".peso"},{"text":", because those names span several","type":"text"},{"text":" ","type":"text"},{"text":"currencies.","type":"text"}]},{"level":3,"type":"heading","text":"Mass versus weight","anchor":"Mass-versus-weight"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Mass and weight are different things, and the namespaces make the distinction"},{"type":"text","text":" "},{"type":"text","text":"explicit so the two can never be mixed up."}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/Units\/Mass"},{"type":"text","text":" contains the mass units — "},{"type":"codeVoice","code":"Units.Mass.ounce"},{"text":" is the ounce of","type":"text"},{"text":" ","type":"text"},{"text":"mass (symbol ","type":"text"},{"type":"codeVoice","code":"oz"},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/Units\/Weight"},{"text":" contains the force units, the physics-correct meaning of","type":"text"},{"type":"text","text":" "},{"text":"“weight” — ","type":"text"},{"type":"codeVoice","code":"Units.Weight.ounce"},{"type":"text","text":" is the ounce-force (symbol "},{"type":"codeVoice","code":"ozf"},{"type":"text","text":"), and"},{"type":"text","text":" "},{"code":"Units.Weight.pound","type":"codeVoice"},{"type":"text","text":" is the pound-force (symbol "},{"type":"codeVoice","code":"lbf"},{"type":"text","text":")."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Some words mean different physical things in different contexts. Beyond","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"ounce"},{"type":"text","text":" and "},{"type":"codeVoice","code":"pound"},{"text":", ","type":"text"},{"type":"codeVoice","code":"dram"},{"text":" is available as a mass unit (","type":"text"},{"type":"codeVoice","code":"Units.Mass.dram"},{"text":"),","type":"text"},{"text":" ","type":"text"},{"text":"a weight\/force unit (","type":"text"},{"type":"codeVoice","code":"Units.Weight.dram"},{"text":", the dram-force), and a volume unit","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"Units.Volume.dram"},{"text":", the US fluid dram, one eighth of a US fluid ounce).","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Because they live in different namespaces, the compiler keeps the two apart:","type":"text"}]},{"type":"codeListing","code":["let flour = Quantity(16, Units.Mass.ounce)   \/\/ 16 oz of mass","let force = Quantity(16, Units.Weight.ounce) \/\/ 16 ozf of force","let sack = Quantity(2, Units.Mass.dram)      \