":"Getting Started with Math","identifier":"doc:\/\/Math\/documentation\/Math\/GettingStarted","type":"topic","kind":"article"},"doc://Math/documentation/Math/Units/Mass":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Mass"}],"type":"topic","identifier":"doc:\/\/Math\/documentation\/Math\/Units\/Mass","title":"Units.Mass","kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Mass"}],"abstract":[{"text":"Units grouped by dimension for convenient, dimension-scoped access.","type":"text"}],"url":"\/documentation\/math\/units\/mass"},"doc://Math/documentation/Math/Units/Energy":{"title":"Units.Energy","type":"topic","abstract":[{"text":"Units grouped by dimension for convenient, dimension-scoped access.","type":"text"}],"identifier":"doc:\/\/Math\/documentation\/Math\/Units\/Energy","role":"symbol","kind":"symbol","url":"\/documentation\/math\/units\/energy","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Energy"}],"navigatorTitle":[{"kind":"identifier","text":"Energy"}]},"doc://Math/documentation/Math/Units/Time":{"kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Time"}],"type":"topic","identifier":"doc:\/\/Math\/documentation\/Math\/Units\/Time","navigatorTitle":[{"kind":"identifier","text":"Time"}],"url":"\/documentation\/math\/units\/time","title":"Units.Time","abstract":[{"type":"text","text":"Units grouped by dimension for convenient, dimension-scoped access."}],"role":"symbol"},"doc://Math/documentation/Math/WorkingWithQuantity":{"title":"Working with Quantity","abstract":[{"text":"Create, convert, compare, compute with, and format ","type":"text"},{"identifier":"doc:\/\/Math\/documentation\/Math\/Quantity","isActive":true,"type":"reference"},{"text":" values in your app.","type":"text"}],"type":"topic","identifier":"doc:\/\/Math\/documentation\/Math\/WorkingWithQ