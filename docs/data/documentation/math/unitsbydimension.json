{"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Browse the unit catalog one dimension at a time, and keep mass and weight straight."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/math\/unitsbydimension"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Math\/documentation\/Math\/UnitsByDimension"},"sections":[],"metadata":{"modules":[{"name":"Math"}],"roleHeading":"Article","role":"article","title":"Looking Up Units by Dimension"},"seeAlsoSections":[{"identifiers":["doc:\/\/Math\/documentation\/Math\/GettingStarted","doc:\/\/Math\/documentation\/Math\/WorkingWithQuantity","doc:\/\/Math\/documentation\/Math\/StoringAndEncodingQuantities","doc:\/\/Math\/documentation\/Math\/Quantity"],"generated":true,"anchor":"Essentials","title":"Essentials"}],"hierarchy":{"paths":[["doc:\/\/Math\/documentation\/Math"]]},"kind":"article","primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Every unit in ","type":"text"},{"identifier":"doc:\/\/Math\/documentation\/Math\/Units","isActive":true,"type":"reference"},{"text":" is defined twice: once as a flat, ready-made value","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"Units.cup","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Units.newton","type":"codeVoice"},{"text":"), and once under a namespace named after its","type":"text"},{"text":" ","type":"text"},{"text":"dimension (","type":"text"},{"code":"Units.Volume.cup","type":"codeVoice"},{"type":"text","text":", "},{"code":"Units.Weight.newton","type":"codeVoice"},{"type":"text","text":"). The namespaces give you"},{"text":" ","type":"text"},{"type":"text","text":"a way to see, enumerate, and pick from just one dimension."}]},{"level":2,"text":"The dimension namespaces","anchor":"The-dimension-namespaces","type":"heading"},{"inlineContent":[{"text":"The generated namespaces mirror the framework’s dimensions:","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Namespace"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Dimension","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Example units","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/Units\/Length"}]}],[{"type":"paragraph","inlineContent":[{"code":"length","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"meter","type":"codeVoice"},{"text":", ","type":"text"},{"code":"mile","type":"codeVoice"},{"text":", ","type":"text"},{"code":"lightYear","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/Units\/Time","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"code":"time","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"second","type":"codeVoice"},{"type":"text","text":", "},{"code":"hour","type":"codeVoice"},{"type":"text","text":", "},{"code":"day","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/Units\/Mass","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"code":"mass","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"gram"},{"type":"text","text":", "},{"type":"codeVoice","code":"pound"},{"type":"text","text":", "},{"type":"codeVoice","code":"slug"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/Units\/Volume","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"code":"volume","type":"codeVoice"}]}],[{"inlineContent":[{"type":"codeVoice","code":"cup"},{"type":"text","text":", "},{"type":"codeVoice","code":"liter"},{"type":"text","text":", "},{"type":"codeVoice","code":"gallon"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/Units\/Data","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"data"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"byte"},{"text":", ","type":"text"},{"type":"codeVoice","code":"gibibyte"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/Units\/Energy","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"energy"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"code":"kelvin","type":"codeVoice"},{"type":"text","text":", "},{"code":"joule","type":"codeVoice"},{"type":"text","text":", "},{"code":"calorie","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/Units\/Currency","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"code":"currency","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"usd","type":"codeVoice"},{"type":"text","text":", "},{"code":"eur","type":"codeVoice"},{"type":"text","text":", "},{"code":"btc","type":"codeVoice"}]}]],[[{"inlineContent":[{"text":"…and more","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"…","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"…","type":"text"}]}]]],"type":"table"},{"inlineContent":[{"type":"text","text":"Each namespace also exposes "},{"code":"all","type":"codeVoice"},{"type":"text","text":", an array of every base unit in its dimension,"},{"type":"text","text":" "},{"text":"which is handy for building menus and pickers:","type":"text"}],"type":"paragraph"},{"code":["for unit in Units.Volume.all {","    print(unit.symbol)","}"],"syntax":"swift","type":"codeListing"},{"text":"Currency common names","level":4,"anchor":"Currency-common-names","type":"heading"},{"inlineContent":[{"text":"The currency dimension is special: most names are only meaningful with their","type":"text"},{"text":" ","type":"text"},{"text":"country code, so the explicit spellings stay (","type":"text"},{"type":"codeVoice","code":"Units.usd"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Units.cad"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Units.currency.mxn"},{"text":", …). Currencies whose common name is unambiguous get","type":"text"},{"text":" ","type":"text"},{"text":"colloquial aliases in every access style — ","type":"text"},{"type":"codeVoice","code":"Units.pounds"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Units.Currency.sterling"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"type":"codeVoice","code":"Quantity(value: 100, unit: .poundsSterling)"},{"text":" all refer to the British pound","type":"text"},{"text":" ","type":"text"},{"text":"(GBP), ","type":"text"},{"type":"codeVoice","code":".yen"},{"text":" to JPY, ","type":"text"},{"type":"codeVoice","code":".franc"},{"text":" to CHF, ","type":"text"},{"type":"codeVoice","code":".rupee"},{"text":" to INR, and so on. There is","type":"text"},{"text":" ","type":"text"},{"text":"deliberately no bare ","type":"text"},{"type":"codeVoice","code":".dollar"},{"text":" or ","type":"text"},{"type":"codeVoice","code":".peso"},{"text":", because those names span several","type":"text"},{"text":" ","type":"text"},{"text":"currencies.","type":"text"}],"type":"paragraph"},{"level":4,"text":"Decibels","anchor":"Decibels","type":"heading"},{"inlineContent":[{"text":"Decibels are logarithmic, so they are modeled with a","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/PowerLawConverter","isActive":true},{"text":" rather than a linear scale. Relative decibels are","type":"text"},{"text":" ","type":"text"},{"text":"dimensionless power ratios (","type":"text"},{"type":"codeVoice","code":"10 dB = 10·log10(P₁\/P₂)"},{"text":", i.e. a tenfold power","type":"text"},{"text":" ","type":"text"},{"text":"increase) and live in ","type":"text"},{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/Units\/Dimensionless","isActive":true},{"text":" as ","type":"text"},{"type":"codeVoice","code":"bel"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"decibel"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Absolute scales pin a reference at the zero reading and belong to the","type":"text"},{"text":" ","type":"text"},{"text":"dimension they measure, so they convert exactly to the linear units of that","type":"text"},{"text":" ","type":"text"},{"text":"dimension:","type":"text"}],"type":"paragraph"},{"code":["let power = Quantity(value: 30, unit: .decibelMilliwatt) \/\/ 30 dBm","print(power.converted(to: .watt).value)                  \/\/ 1.0  (0 dBm = 1 mW)","","let voltage = Quantity(value: 120, unit: .decibelMicrovolt)","print(voltage.converted(to: .volt).value)                \/\/ 1.0  (120 dBµV = 1 V)","","let quiet = Quantity(value: 0, unit: .decibelSoundPressureLevel)","print(quiet.converted(to: .pascal).value)                \/\/ 2e-5 (0 dB SPL = 20 µPa)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Power-ratio scales ("},{"code":"decibelMilliwatt","type":"codeVoice"},{"type":"text","text":", "},{"code":"decibelWatt","type":"codeVoice"},{"type":"text","text":", the dimensionless"},{"type":"text","text":" "},{"code":"decibel","type":"codeVoice"},{"type":"text","text":") step by "},{"code":"10^(1\/10)","type":"codeVoice"},{"type":"text","text":"; voltage and pressure scales"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"decibelVolt","type":"codeVoice"},{"type":"text","text":", "},{"code":"decibelMicrovolt","type":"codeVoice"},{"type":"text","text":", "},{"code":"decibelSoundPressureLevel","type":"codeVoice"},{"type":"text","text":") use the"},{"type":"text","text":" "},{"type":"text","text":"field convention "},{"code":"10^(1\/20)","type":"codeVoice"},{"type":"text","text":" since they are squared into power."}],"type":"paragraph"},{"level":3,"text":"Mass versus weight","anchor":"Mass-versus-weight","type":"heading"},{"inlineContent":[{"type":"text","text":"Mass and weight are different things, and the namespaces make the distinction"},{"type":"text","text":" "},{"type":"text","text":"explicit so the two can never be mixed up."}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/Units\/Mass"},{"text":" contains the mass units — ","type":"text"},{"code":"Units.Mass.ounce","type":"codeVoice"},{"text":" is the ounce of","type":"text"},{"text":" ","type":"text"},{"text":"mass (symbol ","type":"text"},{"code":"oz","type":"codeVoice"},{"text":").","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/Units\/Weight"},{"text":" contains the force units, the physics-correct meaning of","type":"text"},{"text":" ","type":"text"},{"text":"“weight” — ","type":"text"},{"code":"Units.Weight.ounce","type":"codeVoice"},{"text":" is the ounce-force (symbol ","type":"text"},{"code":"ozf","type":"codeVoice"},{"text":"), and","type":"text"},{"text":" ","type":"text"},{"code":"Units.Weight.pound","type":"codeVoice"},{"text":" is the pound-force (symbol ","type":"text"},{"code":"lbf","type":"codeVoice"},{"text":").","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Some words mean different physical things in different contexts. Beyond"},{"type":"text","text":" "},{"type":"codeVoice","code":"ounce"},{"type":"text","text":" and "},{"type":"codeVoice","code":"pound"},{"type":"text","text":", "},{"type":"codeVoice","code":"dram"},{"type":"text","text":" is available as a mass unit ("},{"type":"codeVoice","code":"Units.Mass.dram"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"a weight\/force unit ("},{"type":"codeVoice","code":"Units.Weight.dram"},{"type":"text","text":", the dram-force), and a volume unit"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"Units.Volume.dram"},{"type":"text","text":", the US fluid dram, one eighth of a US fluid ounce)."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Because they live in different namespaces, the compiler keeps the two apart:"}]},{"type":"codeListing","syntax":"swift","code":["let flour = Quantity(16, Units.Mass.ounce)   \/\/ 16 oz of mass","let force = Quantity(16, Units.Weight.ounce) \/\/ 16 ozf of force","let sack = Quantity(2, Units.Mass.dram)      \/\/ 2 dr of mass","let pull = Quantity(2, Units.Weight.dram)    \/\/ 2 dram-force","let dose = Quantity(2, Units.Volume.dram)    \/\/ 2 fl dr of volume"]},{"type":"heading","text":"Leading-dot lookup","level":2,"anchor":"Leading-dot-lookup"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Inside a "},{"type":"codeVoice","code":"Quantity"},{"type":"text","text":" initializer — whose "},{"type":"codeVoice","code":"unit:"},{"type":"text","text":" parameter is a generic"},{"type":"text","text":" "},{"type":"codeVoice","code":"U: MathUnit"},{"type":"text","text":" — the dimensions are available as leading-dot namespaces:"}]},{"type":"codeListing","syntax":"swift","code":["let oil = Quantity(value: 10, unit: .volume.fluidOunce)","let punch = Quantity(value: 2, unit: .volume.liter).converted(to: .volume.cup)","let force = Quantity(value: 150, unit: .weight.pound)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The first member ("},{"type":"codeVoice","code":".volume"},{"type":"text","text":", "},{"type":"codeVoice","code":".mass"},{"type":"text","text":", "},{"type":"codeVoice","code":".weight"},{"type":"text","text":", …) resolves to that"},{"type":"text","text":" "},{"type":"text","text":"dimension’s namespace, and the second member chains onto any of its units —"},{"type":"text","text":" "},{"type":"text","text":"base or prefixed. The mass-versus-weight rule still applies: "},{"type":"codeVoice","code":".mass.pound"},{"type":"text","text":" is a"},{"type":"text","text":" "},{"type":"text","text":"mass unit and "},{"type":"codeVoice","code":".weight.pound"},{"type":"text","text":" is a force unit."}]},{"type":"codeListing","syntax":"swift","code":["let precise = Quantity(value: 1, unit: .voltage.nanovolt) \/\/ nV","let sticky  = Quantity(value: 500, unit: .volume.milliliter)","let disk    = Quantity(value: 1, unit: .data.gibibyte)    \/\/ GiB"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every unit is also available bare, without the dimension name: "},{"type":"codeVoice","code":".nanovolt"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":".voltage.nanovolt"},{"type":"text","text":" are the same unit. The "},{"type":"codeVoice","code":"Units.units(for:)"},{"type":"text","text":" catalog keeps"},{"type":"text","text":" "},{"type":"text","text":"listing just the base units of each dimension, so the pickers stay compact."}]},{"type":"heading","text":"Looking units up at runtime","level":3,"anchor":"Looking-units-up-at-runtime"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Units.units(for:)"},{"type":"text","text":" returns every base unit of a dimension as "},{"type":"codeVoice","code":"[any MathUnit]"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["let volumeUnits = Units.units(for: .volume) \/\/ [Units.Volume.all]","let forceUnits  = Units.units(for: .force)  \/\/ never contains mass units"]}]}],"references":{"doc://Math/documentation/Math/Units/Dimensionless":{"kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier"