{"identifier":{"url":"doc:\/\/Math\/documentation\/Math\/UnitsByDimension","interfaceLanguage":"swift"},"sections":[],"kind":"article","schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"text","text":"Browse the unit catalog one dimension at a time, and keep mass and weight straight."}],"metadata":{"title":"Looking Up Units by Dimension","role":"article","modules":[{"name":"Math"}],"roleHeading":"Article"},"seeAlsoSections":[{"anchor":"Essentials","identifiers":["doc:\/\/Math\/documentation\/Math\/GettingStarted","doc:\/\/Math\/documentation\/Math\/WorkingWithQuantity","doc:\/\/Math\/documentation\/Math\/StoringAndEncodingQuantities","doc:\/\/Math\/documentation\/Math\/Quantity"],"generated":true,"title":"Essentials"}],"variants":[{"paths":["\/documentation\/math\/unitsbydimension"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/Math\/documentation\/Math"]]},"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Every unit in ","type":"text"},{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/Units","isActive":true},{"type":"text","text":" is defined twice: once as a flat, ready-made value"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"Units.cup","type":"codeVoice"},{"type":"text","text":", "},{"type":"codeVoice","code":"Units.newton"},{"type":"text","text":"), and once under a namespace named after its"},{"text":" ","type":"text"},{"text":"dimension (","type":"text"},{"type":"codeVoice","code":"Units.Volume.cup"},{"text":", ","type":"text"},{"code":"Units.Weight.newton","type":"codeVoice"},{"text":"). The namespaces give you","type":"text"},{"type":"text","text":" "},{"text":"a way to see, enumerate, and pick from just one dimension.","type":"text"}]},{"type":"heading","level":2,"text":"The dimension namespaces","anchor":"The-dimension-namespaces"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The generated namespaces mirror the framework’s dimensions:"}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Namespace"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Dimension"}]}],[{"type":"paragraph","inlineContent":[{"text":"Example units","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Math\/documentation\/Math\/Units\/Length","type":"reference","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"code":"length","type":"codeVoice"}]}],[{"inlineContent":[{"code":"meter","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":"mile"},{"text":", ","type":"text"},{"type":"codeVoice","code":"lightYear"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/Units\/Time"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"time"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"second"},{"type":"text","text":", "},{"type":"codeVoice","code":"hour"},{"type":"text","text":", "},{"type":"codeVoice","code":"day"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/Units\/Mass"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"mass"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"gram"},{"type":"text","text":", "},{"type":"codeVoice","code":"pound"},{"type":"text","text":", "},{"type":"codeVoice","code":"slug"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/Units\/Volume"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"volume"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"cup"},{"type":"text","text":", "},{"type":"codeVoice","code":"liter"},{"type":"text","text":", "},{"type":"codeVoice","code":"gallon"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/Units\/Data"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"data"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"byte"},{"type":"text","text":", "},{"type":"codeVoice","code":"gibibyte"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/Units\/Energy"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"energy"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"kelvin"},{"type":"text","text":", "},{"type":"codeVoice","code":"joule"},{"type":"text","text":", "},{"type":"codeVoice","code":"calorie"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/Units\/Currency"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"currency"}]}],[{"type":"paragraph","inlineContent":[{"code":"usd","type":"codeVoice"},{"type":"text","text":", "},{"type":"codeVoice","code":"eur"},{"type":"text","text":", "},{"type":"codeVoice","code":"btc"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"…and more","type":"text"}]}],[{"inlineContent":[{"type":"text","text":"…"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"…"}]}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each namespace also exposes "},{"code":"all","type":"codeVoice"},{"type":"text","text":", an array of every base unit in its dimension,"},{"type":"text","text":" "},{"type":"text","text":"which is handy for building menus and pickers:"}]},{"type":"codeListing","syntax":"swift","code":["for unit in Units.Volume.all {","    print(unit.symbol)","}"]},{"level":4,"anchor":"Currency-common-names","type":"heading","text":"Currency common names"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The currency dimension is special: most names are only meaningful with their"},{"type":"text","text":" "},{"type":"text","text":"country code, so the explicit spellings stay ("},{"code":"Units.usd","type":"codeVoice"},{"type":"text","text":", "},{"code":"Units.cad","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"Units.currency.mxn","type":"codeVoice"},{"type":"text","text":", …). Currencies whose common name is unambiguous get"},{"type":"text","text":" "},{"type":"text","text":"colloquial aliases in every access style — "},{"code":"Units.pounds","type":"codeVoice"},{"type":"text","text":", "},{"code":"Units.Currency.sterling","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and "},{"code":"Quantity(value: 100, unit: .poundsSterling)","type":"codeVoice"},{"type":"text","text":" all refer to the British pound"},{"type":"text","text":" "},{"type":"text","text":"(GBP), "},{"code":".yen","type":"codeVoice"},{"type":"text","text":" to JPY, "},{"code":".franc","type":"codeVoice"},{"type":"text","text":" to CHF, "},{"code":".rupee","type":"codeVoice"},{"type":"text","text":" to INR, and so on. There is"},{"type":"text","text":" "},{"type":"text","text":"deliberately no bare "},{"code":".dollar","type":"codeVoice"},{"type":"text","text":" or "},{"code":".peso","type":"codeVoice"},{"type":"text","text":", because those names span several"},{"type":"text","text":" "},{"type":"text","text":"currencies."}]},{"level":3,"anchor":"Mass-versus-weight","type":"heading","text":"Mass versus weight"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Mass and weight are different things, and the namespaces make the distinction"},{"type":"text","text":" "},{"type":"text","text":"explicit so the two can never be mixed up."}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/Units\/Mass"},{"type":"text","text":" contains the mass units — "},{"type":"codeVoice","code":"Units.Mass.ounce"},{"type":"text","text":" is the ounce of"},{"type":"text","text":" "},{"type":"text","text":"mass (symbol "},{"type":"codeVoice","code":"oz"},{"type":"text","text":")."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/Units\/Weight"},{"type":"text","text":" contains the force units, the physics-correct meaning of"},{"type":"text","text":" "},{"type":"text","text":"“weight” — "},{"type":"codeVoice","code":"Units.Weight.ounce"},{"type":"text","text":" is the ounce-force (symbol "},{"type":"codeVoice","code":"ozf"},{"type":"text","text":"), and"},{"type":"text","text":" "},{"type":"codeVoice","code":"Units.Weight.pound"},{"type":"text","text":" is the pound-force (symbol "},{"type":"codeVoice","code":"lbf"},{"type":"text","text":")."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Because they live in different namespaces, the compiler keeps the two apart:"}]},{"type":"codeListing","syntax":"swift","code":["let flour = Quantity(16, Units.Mass.ounce)   \/\/ 16 oz of mass","let force = Quantity(16, Units.Weight.ounce) \/\/ 16 ozf of force"]},{"level":2,"anchor":"Leading-dot-lookup","type":"heading","text":"Leading-dot lookup"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Inside a "},{"code":"Quantity","type":"codeVoice"},{"type":"text","text":" initializer — whose "},{"code":"unit:","type":"codeVoice"},{"type":"text","text":" parameter is a generic"},{"type":"text","text":" "},{"code":"U: MathUnit","type":"codeVoice"},{"type":"text","text":" — the dimensions are available as leading-dot namespaces:"}]},{"type":"codeListing","syntax":"swift","code":["let oil = Quantity(value: 10, unit: .volume.fluidOunce)","let punch = Quantity(value: 2, unit: .volume.liter).converted(to: .volume.cup)","let force = Quantity(value: 150, unit: .weight.pound)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The first member ("},{"code":".volume","type":"codeVoice"},{"type":"text","text":", "},{"code":".mass","type":"codeVoice"},{"type":"text","text":", "},{"code":".weight","type":"codeVoice"},{"type":"text","text":", …) resolves to that"},{"type":"text","text":" "},{"type":"text","text":"dimension’s namespace, and the second member chains onto any of its units —"},{"type":"text","text":" "},{"type":"text","text":"base or prefixed. The mass-versus-weight rule still applies: "},{"type":"codeVoice","code":".mass.pound"},{"type":"text","text":" is a"},{"type":"text","text":" "},{"type":"text","text":"mass unit and "},{"type":"codeVoice","code":".weight.pound"},{"type":"text","text":" is a force unit."}]},{"type":"codeListing","syntax":"swift","code":["let precise = Quantity(value: 1, unit: .voltage.nanovolt) \/\/ nV","let sticky  = Quantity(value: 500, unit: .volume.milliliter)","let disk    = Quantity(value: 1, unit: .data.gibibyte)    \/\/ GiB"]},{"type":"paragraph","inlineContent":[{"text":"Every unit is also available bare, without the dimension name: ","type":"text"},{"code":".nanovolt","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":".voltage.nanovolt","type":"codeVoice"},{"text":" are the same unit. The ","type":"text"},{"code":"Units.units(for:)","type":"codeVoice"},{"text":" catalog keeps","type":"text"},{"type":"text","text":" "},{"type":"text","text":"listing just the base units of each dimension, so the pickers stay compact."}]},{"level":3,"type":"heading","text":"Looking units up at runtime","anchor":"Looking-units-up-at-runtime"},{"inlineContent":[{"type":"codeVoice","code":"Units.units(for:)"},{"type":"text","text":" returns every base unit of a dimension as "},{"type":"codeVoice","code":"[any MathUnit]"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["let volumeUnits = Units.units(for: .volume) \/\/ [Units.Vol