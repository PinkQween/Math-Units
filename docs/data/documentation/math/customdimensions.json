th/documentation/Math/NamedUnit":{"abstract":[{"text":"A unit with a fixed symbol and dimension, parameterized by its compile-time","type":"text"},{"text":" ","type":"text"},{"text":"dimension type.","type":"text"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"NamedUnit"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NamedUnit"}],"identifier":"doc:\/\/Math\/documentation\/Math\/NamedUnit","url":"\/documentation\/math\/namedunit","title":"NamedUnit","type":"topic"},"doc://Math/documentation/Math/PhysicalDimension/currency":{"title":"currency","identifier":"doc:\/\/Math\/documentation\/Math\/PhysicalDimension\/currency","kind":"symbol","abstract":[{"type":"text","text":"The dimension of currency."}],"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"currency"},{"kind":"text","text":": `Self`"}],"url":"\/documentation\/math\/physicaldimension\/currency"},"doc://Math/documentation/Math/OffsetConverter":{"title":"OffsetConverter","identifier":"doc:\/\/Math\/documentation\/Math\/OffsetConverter","kind":"symbol","abstract":[{"type":"text","text":"A "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/UnitConverter"},{"type":"text","text":" that scales values by a coefficient and adds a constant"},{"type":"text","text":" "},{"type":"text","text":"offset."}],"type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OffsetConverter","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"OffsetConverter"}],"url":"\/documentation\/math\/offsetconverter"},"doc://Math/documentation/Math/CompileTimeSafety":{"url":"\/documentation\/math\/compiletimesafety","type":"topic","title":"Compile-Time Dimension Type Safety","kind":"article","abstract":[{"text":"Use generic constraints to make sure your APIs only ever receive the right kind of quantity.","type":"text"}],"identifier":"doc:\/\/Math\/documentation\/Math\/CompileTimeSafety","role":"article"},"doc://Math/documentation/Math/PhysicalDimension/time":{"title":"time","identifier":"doc:\/\/Math\/documentation\/Math\/PhysicalDimension\/time","kind":"symbol","abstract":[{"type":"text","text":"The dimension of time (SI base unit: second)."}],"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"time"},{"kind":"text","text":": `Self`"}],"url":"\/documentation\/math\/physicaldimension\/time"},"doc://Math/documentation/Math/UnitConverter":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UnitConverter","kind":"identifier"}],"url":"\/documentation\/math\/unitconverter","kind":"symbol","identifier":"doc:\/\/Math\/documentation\/Math\/UnitConverter","title":"UnitConverter","role":"symbol","abstract":[{"type":"text","text":"A type that converts numeric values between a unit and the base unit of its"},{"type":"text","text":" "},{"type":"text","text":"dimension."}],"navigatorTitle":[{"text":"UnitConverter","kind":"identifier"}],"type":"topic"},"doc://Math/documentation/Math/PhysicalDimension/speed":{"url":"\/documentation\/math\/physicaldimension\/speed","type":"topic","title":"speed","kind":"symbol","abstract":[{"type":"text","text":"The dimension of speed ("},{"type":"codeVoice","code":"length \/ time"},{"type":"text","text":")."}],"identifier":"doc:\/\/Math\/documentation\/Math\/PhysicalDimension\/speed","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"speed"},{"kind":"text","text":": `Self`"}],"role":"symbol"},"doc://Math/documentation/Math/LinearConverter":{"title":"LinearConverter"