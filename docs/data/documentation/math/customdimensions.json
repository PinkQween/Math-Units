,"kind":"text"}]},"doc://Math/documentation/Math/OffsetConverter":{"navigatorTitle":[{"kind":"identifier","text":"OffsetConverter"}],"abstract":[{"type":"text","text":"A "},{"identifier":"doc:\/\/Math\/documentation\/Math\/UnitConverter","isActive":true,"type":"reference"},{"type":"text","text":" that scales values by a coefficient and adds a constant"},{"type":"text","text":" "},{"type":"text","text":"offset."}],"identifier":"doc:\/\/Math\/documentation\/Math\/OffsetConverter","url":"\/documentation\/math\/offsetconverter","type":"topic","kind":"symbol","title":"OffsetConverter","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OffsetConverter"}]},"doc://Math/documentation/Math/LinearConverter":{"type":"topic","title":"LinearConverter","kind":"symbol","abstract":[{"type":"text","text":"A "},{"identifier":"doc:\/\/Math\/documentation\/Math\/UnitConverter","isActive":true,"type":"reference"},{"text":" that scales values by a fixed coefficient.","type":"text"}],"identifier":"doc:\/\/Math\/documentation\/Math\/LinearConverter","url":"\/documentation\/math\/linearconverter","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"LinearConverter"}],"navigatorTitle":[{"text":"LinearConverter","kind":"identifier"}]},"doc://Math/documentation/Math/PhysicalDimension/speed":{"type":"topic","kind":"symbol","title":"speed","abstract":[{"type":"text","text":"The dimension of speed ("},{"code":"length \/ time","type":"codeVoice"},{"type":"text","text":")."}],"url":"\/documentation\/math\/physicaldimension\/speed","identifier":"doc:\/\/Math\/documentation\/Math\/PhysicalDimension\/speed","role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"speed","kind":"identifier"},{"text":": `Self`","kind":"text"}]},"doc://Math/documentation/Math/PhysicalDimension/energy":{"type":"topic","kind":"symbol","title":"energy","abstract":[{"type":"text","text":"The dimension of energy ("},{"code":"force × length","type":"codeVoice"},{"type":"text","text":", SI unit: joule)."}],"url":"\/documentation\/math\/physicaldimension\/energy","identifier":"doc:\/\/Math\/documentation\/Math\/PhysicalDimension\/energy","role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"energy","kind":"identifier"},{"text":": `Self`","kind":"text"}]},"doc://Math/documentation/Math/CompileTimeSafety":{"type":"topic","kind":"article","role":"article","title":"Compile-Time Dimension Type Safety","url":"\/documentation\/math\/compiletimesafety","abstract":[{"type":"text","text":"Use generic constraints to make sure your APIs only ever receive the right kind of quantity."}],"identifier":"doc:\/\/Math\/documentation\/Math\/CompileTimeSafety"},"doc://Math/documentation/Math/Units":{"abstract":[{"type":"text","text":"A namespace of ready-made units for every dimension in the framework."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Units","kind":"identifier"}],"navigatorTitle":[{"text":"Units","kind":"identifier"}],"url":"\/documentation\/math\/units","kind":"symbol","title":"Units","identifier":"doc:\/\/Math\/documentation\/Math\/Units","type":"topic"},"doc://Math/documentation/Math/PhysicalDimension":{"identifier":"doc:\/\/Math\/documentation\/Math\/PhysicalDimension","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"PhysicalDimension"}],"abstract":[{"type":"text","text":"A type representing a physical dimension as a canonical dictionary of base SI dimension exponents."}],"type":"topic","role":"symbol","title":"PhysicalDimension","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"PhysicalDimension"}],"url":"\/documentation\/math\/physic