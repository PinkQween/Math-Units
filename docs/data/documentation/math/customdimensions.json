{"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"title":"Custom Dimensions and Units","modules":[{"name":"Math"}],"roleHeading":"Article","role":"article"},"identifier":{"url":"doc:\/\/Math\/documentation\/Math\/CustomDimensions","interfaceLanguage":"swift"},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/Math\/documentation\/Math\/CompileTimeSafety"],"anchor":"Extending-the-Framework","title":"Extending the Framework"}],"kind":"article","hierarchy":{"paths":[["doc:\/\/Math\/documentation\/Math"]]},"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"inlineContent":[{"code":"Math","type":"codeVoice"},{"type":"text","text":" ships with a comprehensive set of base dimensions ("},{"identifier":"doc:\/\/Math\/documentation\/Math\/PhysicalDimension\/length","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/Math\/documentation\/Math\/PhysicalDimension\/time","type":"reference","isActive":true},{"type":"text","text":", and friends) and derived dimensions ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/PhysicalDimension\/speed"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/PhysicalDimension\/energy"},{"type":"text","text":", and more). These cover physics and everyday measurement, but your app almost certainly measures things that aren’t in the SI system too: money, hit points, ingredients, resource points, users, and so on."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The good news: "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/PhysicalDimension"},{"text":" is an open system. Because a dimension is ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"just a dictionary of exponent powers","type":"text"}]},{"type":"text","text":", you can describe any dimension you can imagine at runtime."}],"type":"paragraph"},{"level":3,"type":"heading","text":"Define a Custom Dimension","anchor":"Define-a-Custom-Dimension"},{"inlineContent":[{"type":"text","text":"Create a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/PhysicalDimension"},{"type":"text","text":" with a dictionary of exponent identifiers. Each key is a dimension name and each value is its power:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import Math","","\/\/ A dimension for money, with a single base exponent.","let usdDimension = PhysicalDimension(exponents: [\"USD\": 1])","","\/\/ A dimension for \"users\", used later in per-user metrics.","let userDimension = PhysicalDimension(exponents: [\"user\": 1])"]},{"inlineContent":[{"type":"text","text":"You can build compound custom dimensions with the same arithmetic used"},{"type":"text","text":" "},{"type":"text","text":"internally: "},{"type":"codeVoice","code":"+"},{"type":"text","text":" multiplies dimensions, "},{"type":"codeVoice","code":"-"},{"type":"text","text":" divides them, and "},{"code":"*","type":"codeVoice"},{"text":" with an","type":"text"},{"text":" ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" raises a dimension to a power:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let revenuePerUser = usdDimension - userDimension   \/\/ [\"USD\": 1, \"user\": -1]"]},{"level":3,"type":"heading","text":"Define Custom Units","anchor":"Define-Custom-Units"},{"inlineContent":[{"text":"Custom dimensions don’t have a compile-time type, so use","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension\/unknown","type":"reference","isActive":true},{"text":" as the type-level parameter and ","type":"text"},{"identifier":"doc:\/\/Math\/documentation\/Math\/NamedUnit","type":"reference","isActive":true},{"text":" to","type":"text"},{"text":" ","type":"text"},{"text":"create units. Pass a ","type":"text"},{"identifier":"doc:\/\/Math\/documentation\/Math\/LinearConverter","type":"reference","isActive":true},{"text":" (for a simple scale) or an","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Math\/documentation\/Math\/OffsetConverter","type":"reference","isActive":true},{"text":" (for a scale plus an offset) to handle conversions:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let usdUnit = NamedUnit<MathDimension.unknown>(","    symbol: \"$\",","    dimension: usdDimension,","    converter: LinearConverter(coefficient: 1.0)",")","","\/\/ EUR is defined relative to the same base dimension.","let eurUnit = NamedUnit<MathDimension.unknown>(","    symbol: \"€\",","    dimension: usdDimension,","    converter: LinearConverter(coefficient: 1.09)",")"]},{"content":[{"inlineContent":[{"text":"Keep the same ","type":"text"},{"code":"PhysicalDimension","type":"codeVoice"},{"text":" value (here ","type":"text"},{"code":"usdDimension","type":"codeVoice"},{"text":") for every","type":"text"},{"text":" ","type":"text"},{"text":"unit in a family. The framework only converts between units whose dimensions","type":"text"},{"text":" ","type":"text"},{"text":"match, so sharing the exact same value makes your money interchangeable.","type":"text"}],"type":"paragraph"}],"type":"aside","style":"tip","name":"Tip"},{"level":3,"type":"heading","text":"Convert Between Custom Units","anchor":"Convert-Between-Custom-Units"},{"inlineContent":[{"text":"Custom units convert exactly like the built-in ones:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let walletInEur = Quantity(value: 100.0, unit: eurUnit)","let walletInUsd = walletInEur.converted(to: usdUnit)","","print(walletInUsd.value) \/\/ 109.0"]},{"level":3,"type":"heading","text":"Combine Custom Units with Built-In Ones","anchor":"Combine-Custom-Units-with-Built-In-Ones"},{"inlineContent":[{"text":"Custom dimensions participate in dimensional arithmetic too. Here a currency","type":"text"},{"text":" ","type":"text"},{"text":"dimension combines with the built-in ","type":"text"},{"identifier":"doc:\/\/Math\/documentation\/Math\/PhysicalDimension\/time","type":"reference","isActive":true},{"text":" dimension:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let hourlyRate = Quantity(value: 50.0, unit: usdUnit) \/ Quantity(value: 1.0, unit: Units.hour)","","print(hourlyRate.value)          \/\/ 50.0","print(hourlyRate.unit.dimension) \/\/ [\"USD\": 1, \"time\": -1]","print(hourlyRate.unit.symbol)    \/\/ \"($\/h)\""]},{"level":3,"type":"heading","text":"Use the Currency Dimension","anchor":"Use-the-Currency-Dimension"},{"inlineContent":[{"text":"If your custom dimension happens to be currency, ","type":"text"},{"code":"Math","type":"codeVoice"},{"text":" already defines a","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/PhysicalDimension\/currency","type":"reference"},{"text":" dimension and a built-in library of world","type":"text"},{"text":" ","type":"text"},{"text":"currencies (and cryptocurrencies) in ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/Units","type":"reference"},{"text":". Currency units automatically","type":"text"},{"text":" ","type":"text"},{"text":"place their symbol before the value when formatting:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let gift = Quantity(value: 100.0, unit: Units.usd)","print(gift.formatted()) \/\/ \"$100.00\"","","\/\/ Resolve units from ISO 4217 codes at runtime.","if let currency = Units.currency(for: \"SEK\") {","    print(currency.symbol) \/\/ \"kr\"","}"]},{"level":3,"type":"heading","text":"What’s Next?","anchor":"Whats-Next"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Learn how to lock custom units into a compile-time dimension in"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/CompileTimeSafety"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Explore ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/Units","type":"reference"},{"type":"text","text":" to see the breadth of units provided out of the box."}],"type":"paragraph"}]}]}],"kind":"content"}],"sections":[],"abstract":[{"type":"text","text":"Extend "},{"type":"codeVoice","code":"Math"},{"type":"text","text":" with your own physical dimensions and units—currency, points, gameplay metrics, or anything else your app measures."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/math\/customdimensions"]}],"references":{"doc://Math/documentation/Math":{"type":"topic","title":"Math","url":"\/documentation\/math","identifier":"doc:\/\/Math\/documentation\/Math","abstract":[{"text":"Perform type-safe dimensional analysis and unit conversion in your Swift app.","type":"text"}],"kind":"symbol","role":"collection"},"doc://Math/documentation/Math/NamedUnit":{"title":"NamedUnit","kind":"symbol","identifier":"doc:\/\/Math\/documentation\/Math\/NamedUnit","role":"symbol","type":"topic","navigatorTitle":[{"text":"NamedUnit","kind":"identifier"}],"url":"\/documentation\/math\/namedunit","abstract":[{"text":"A unit with a fixed symbol and dimension, parameterized by its compile-time","type":"text"},{"type":"text","text":" "},{"type":"text","text":"dimension type."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"NamedUnit","kind":"identifier"}]},"doc://Math/documentation/Math/Units":{"abstract":[{"type":"text","text":"A namespace of ready-made units for every dimension in the framework."}],"navigatorTitle":[{"text":"Units","kind":"identifier"}],"title":"Units","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"Units"}],"identifier":"doc:\/\/Math\/documentation\/Math\/Units","kind":"symbol","url":"\/documentation\/math\/units","type":"topic","role":"symbol"},"doc://Math/documentation/Math/PhysicalDimension/currency":{"kind":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"currency"},{"kind":"text","text":": `Self`"}],"title":"currency","url":"\/documentation\/math\/physicaldimension\/currency","abstract":[{"type":"text","text":"The dimension of currency."}],"type":"topic","identifier":"doc:\/\/Math\/documentation\/Math\/PhysicalDimension\/currency","role":"symbol"},"doc://Math/documentation/Math/PhysicalDimension/length":{"abstract":[{"type":"text","text":"The dimension of length (SI base unit: meter)."}],"kind":"symbol","type":"topic","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"length","kind":"identifier"},{"text":": `Self`","kind":"text"}],"title":"length","identifier":"doc:\/\/Math\/documentation\/Math\/PhysicalDimension\/length","role":"symbol","url":"\/documentation\/math\/physicaldimension\/length"},"doc://Math/documentation/Math/LinearConverter":{"identifier":"doc:\/\/Math\/documentation\/Math\/LinearConverter","type":"topic","kind":"symbol","title":"LinearConverter","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LinearConverter","kind":"identifier"}],"navigatorTitle":[{"text":"LinearConverter","kind":"identifier"}],"abstract":[{"text":"A ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/UnitConverter","type":"reference"},{"text":" that scales values by a fixed coefficient.","type":"text"}],"role":"symbol","url":"\/documentation\/math\/linearconverter"},"doc://Math/documentation/Math/PhysicalDimension":{"navigatorTitle":[{"text":"PhysicalDimension","kind":"identifier"}],"url":"\/documentation\/math\/physicaldimension","title":"PhysicalDimension","abstract":[{"text":"A type representing a physical dimension as a canonical dictionary of base SI dimension exponents.","type":"text"}],"identifier":"doc:\/\/Math\/documentation\/Math\/PhysicalDimension","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PhysicalDimension","kind":"identifier"}],"role":"symbol","kind":"symbol"},"doc://Math/documentation/Math/OffsetConverter":{"identifier":"doc:\/\/Math\/documentation\/Math\/OffsetConverter","type":"topic","kind":"symbol","title":"OffsetConverter","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OffsetConverter","kind":"identifier"}],"navigatorTitle":[{"text":"OffsetConverter","kind":"identifier"}],"abstract":[{"text":"A ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/UnitConverter","type":"reference"},{"text":" that scales values by a coefficient and adds a constant","type":"text"},{"text":" ","type":"text"},{"text":"offset.","type":"text"}],"role":"symbol","url":"\/documentation\/math\/offsetconverter"},"doc://Math/documentation/Math/CompileTimeSafety":{"identifier":"doc:\/\/Math\/documentation\/Math\/CompileTimeSafety","type":"topic","kind":"article","title":"Compile-Time Dimension Type Safety","abstract":[{"type":"text","text":"Use generic constraints to make sure your APIs only ever receive the right kind of quantity."}],"role":"article","url":"\/documentation\/math\/compiletimesafety"},"doc://Math/documentation/Math/UnitConverter":{"identifier":"doc:\/\/Math\/documentation\/Math\/UnitConverter","type":"topic","kind":"symbol","title":"UnitConverter","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UnitConverter","kind":"identifier"}],"navigatorTitle":[{"text":"UnitConverter","kind":"identifier"}],"abstract":[{"text":"A type that converts numeric values between a unit and the base unit of its","type":"text"},{"text":" ","type":"text"},{"text":"dimension.","type":"text"}],"role":"symbol","url":"\/documentation\/math\/unitconverter"},"doc://Math/documentation/Math/MathDimension/unknown":{"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"unknown"}],"title":"MathDimension.unknown","url":"\/documentation\/math\/mathdimension\/unknown","navigatorTitle":[{"kind":"identifier","text":"unknown"}],"abstract":[{"type":"text","text":"The compile-time dimension type used for dimensions that don’t have a"},{"type":"text","text":" "},{"type":"text","text":"static type, such as custom dimensions created at runtime."}],"type":"topic","identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension\/unknown","role":"symbol"},"doc://Math/documentation/Math/PhysicalDimension/time":{"url":"\/documentation\/math\/physicaldimension\/time","title":"time","identifier":"doc:\/\/Math\/documentation\/Math\/PhysicalDimension\/time","abstract":[{"type":"text","text":"The dimension of time (SI base unit: second)."}],"type":"topic","fragments":[{"text":"static","kind":"keyword"},{"kind":"text","text":" "},{"text":"var","kind":"keyword"},{"kind":"text","text":" "},{"text":"time","kind":"identifier"},{"kind":"text","text":": `Self`"}],"role":"symbol","kind":"symbol"},"doc://Math/documentation/Math/PhysicalDimension/speed":{"abstract":[{"type":"text","text":"The dimension of speed ("},{"type":"codeVoice","code":"length \/ time"},{"type":"text","text":")."}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"speed"},{"kind":"text","text":": `Self`"}],"title":"speed","identifier":"doc:\/\/Math\/documentation\/Math\/PhysicalDimension\/speed","role":"symbol","url":"\/documentation\/math\/physicaldimension\/speed"},"doc://Math/documentation/Math/PhysicalDimension/energy":{"abstract":[{"type":"text","text":"The dimension of energy ("},{"type":"codeVoice","code":"force × length"},{"type":"text","text":", SI unit: joule)."}],"kind":"symbol","type":"topic","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"energy","kind":"identifier"},{"text":": `Self`","kind":"text"}],"title":"energy","identifier":"doc:\/\/Math\/documentation\/Math\/PhysicalDimension\/energy","role":"symbol","url":"\/documentation\/math\/physicaldimension\/energy"}}}