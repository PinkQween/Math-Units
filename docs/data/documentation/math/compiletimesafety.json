{"metadata":{"roleHeading":"Article","role":"article","title":"Compile-Time Dimension Type Safety","modules":[{"name":"Math"}]},"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Math\/documentation\/Math\/CompileTimeSafety"},"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Every ","type":"text"},{"identifier":"doc:\/\/Math\/documentation\/Math\/MathUnit","isActive":true,"type":"reference"},{"text":" carries a compile-time dimension type through its","type":"text"},{"text":" ","type":"text"},{"code":"Dimension","type":"codeVoice"},{"text":" associated type. That type is a ","type":"text"},{"identifier":"doc:\/\/Math\/documentation\/Math\/DimensionProtocol","isActive":true,"type":"reference"},{"text":"-conforming","type":"text"},{"text":" ","type":"text"},{"text":"struct from the ","type":"text"},{"identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension","isActive":true,"type":"reference"},{"text":" namespace, such as ","type":"text"},{"identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension\/length","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"or ","type":"text"},{"identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension\/time","isActive":true,"type":"reference"},{"text":". Because the compiler can see this type, it can","type":"text"},{"text":" ","type":"text"},{"text":"reject dimension mismatches ","type":"text"},{"inlineContent":[{"text":"when you build your app","type":"text"}],"type":"emphasis"},{"text":" instead of when it runs.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Historically, dimensions were only checked at runtime. With compile-time","type":"text"},{"text":" ","type":"text"},{"text":"constraints, a function that declares ","type":"text"},{"inlineContent":[{"text":"“only lengths, please”","type":"text"}],"type":"emphasis"},{"type":"text","text":" is enforced by"},{"text":" ","type":"text"},{"type":"text","text":"the Swift type checker."}]},{"anchor":"Constrain-a-Generic-to-a-Dimension","text":"Constrain a Generic to a Dimension","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Write a generic function or protocol requirement over a unit type "},{"type":"codeVoice","code":"U: MathUnit"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"then constrain "},{"type":"codeVoice","code":"U.Dimension"},{"type":"text","text":" with a "},{"type":"codeVoice","code":"where"},{"type":"text","text":" clause:"}],"type":"paragraph"},{"code":["import Math","","\/\/ This method only accepts quantities of length.","func measureDistance<U: MathUnit>(_ distance: Quantity<U>) -> Bool","where U.Dimension == MathDimension.length {","    distance.value > 0","}"],"syntax":"swift","type":"codeListing"},{"anchor":"Passing-the-Correct-Units","text":"Passing the Correct Units","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"The built-in units in "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/Units"},{"text":" are already parameterized by their dimension.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Passing a length unit compiles cleanly:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let radius = Quantity(value: 500, unit: Units.meter)","measureDistance(radius) \/\/ Compiles perfectly! ✅"]},{"level":3,"anchor":"Preventing-Mismatched-Units","type":"heading","text":"Preventing Mismatched Units"},{"type":"paragraph","inlineContent":[{"text":"Passing a quantity of a different dimension is a compile-time error:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let timeLimit = Quantity(value: 30, unit: Units.minute)","measureDistance(timeLimit) \/\/ ✗ ERROR: 'time' is not 'length'"]},{"level":3,"anchor":"Runtime-Checks-for-Dynamic-Dimensions","type":"heading","text":"Runtime Checks for Dynamic Dimensions"},{"type":"paragraph","inlineContent":[{"text":"Not every quantity has a static dimension. Custom dimensions created at runtime","type":"text"},{"text":" ","type":"text"},{"text":"(see ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/CustomDimensions"},{"text":") use ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension\/unknown"},{"text":" as their type-level","type":"text"},{"text":" ","type":"text"},{"text":"parameter. For those, the compiler can’t help—so ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math"},{"text":" keeps its runtime","type":"text"},{"text":" ","type":"text"},{"text":"safety net. Operations that combine quantities verify that dimensions match and","type":"text"},{"text":" ","type":"text"},{"text":"raise a runtime ","type":"text"},{"code":"preconditionFailure","type":"codeVoice"},{"text":" if they don’t:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let usdDimension = PhysicalDimension(exponents: [\"USD\": 1])","let usdUnit = NamedUnit<MathDimension.unknown>(","    symbol: \"$\", dimension: usdDimension, converter: LinearConverter(coefficient: 1.0)",")","","let userDimension = PhysicalDimension(exponents: [\"user\": 1])","let userUnit = NamedUnit<MathDimension.unknown>(","    symbol: \"user\", dimension: userDimension, converter: LinearConverter(coefficient: 1.0)",")","","\/\/ Traps at runtime: USD ≠ users","let revenue = Quantity(value: 100, unit: usdUnit) + Quantity(value: 3, unit: userUnit)"]},{"level":3,"anchor":"Applying-Constraints-at-the-Protocol-Level","type":"heading","text":"Applying Constraints at the Protocol Level"},{"type":"paragraph","inlineContent":[{"text":"You can attach the same constraint to a protocol so every conformer enforces it:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["protocol DistanceMeasurer {","    func measure<U: MathUnit>(_ distance: Quantity<U>) -> Double","    where U.Dimension == MathDimension.length","}","","\/\/ All built-in length units satisfy this automatically:","struct RangeFinder: DistanceMeasurer {","    func measure<U: MathUnit>(_ distance: Quantity<U>) -> Double","    where U.Dimension == MathDimension.length {","        distance.converted(to: Units.meter).value","    }","}","","let width = Quantity(value: 10, unit: Units.foot)","RangeFinder().measure(width) \/\/ 3.048"]},{"level":3,"anchor":"Whats-Next","type":"heading","text":"What’s Next?"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"See the full list of compile-time dimensions in ","type":"text"},{"identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Combine compile-time safety with your own domain in ","type":"text"},{"identifier":"doc:\/\/Math\/documentation\/Math\/CustomDimensions","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/math\/compiletimesafety"]}],"sections":[],"abstract":[{"text":"Use generic constraints to make sure your APIs only ever receive the right kind of quantity.","type":"text"}],"seeAlsoSections":[{"anchor":"Extending-the-Framework","generated":true,"title":"Extending the Framework","identifiers":["doc:\/\/Math\/documentation\/Math\/CustomDimensions"]}],"hierarchy":{"paths":[["doc:\/\/Math\/documentation\/Math"]]},"references":{"doc://Math/documentation/Math/MathDimension/time":{"title":"MathDimension.time","identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension\/time","abstract":[{"type":"text","text":"The compile-time dimension type representing time."}],"kind":"symbol","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"time"}],"navigatorTitle":[{"kind":"identifier","text":"time"}],"url":"\/documentation\/math\/mathdimension\/time"},"doc://Math/documentation/Math/DimensionProtocol":{"abstract":[{"text":"A protocol representing a type-level identifier for a physical dimension.","type":"text"}],"role":"symbol","navigatorTitle":[{"text":"DimensionProtocol","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DimensionProtocol","kind":"identifier"}],"url":"\/documentation\/math\/dimensionprotocol","identifier":"doc:\/\/Math\/documentation\/Math\/DimensionProtocol","title":"DimensionProtocol","type":"topic"},"doc://Math/documentation/Math/MathDimension/unknown":{"title":"MathDimension.unknown","identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension\/unknown","kind":"symbol","abstract":[{"type":"text","text":"The compile-time dimension type used for dimensions that don’t have a"},{"type":"text","text":" "},{"type":"text","text":"static type, such as custom dimensions created at runtime."}],"type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"unknown"}],"navigatorTitle":[{"text":"unknown","kind":"identifier"}],"url":"\/documentation\/math\/mathdimension\/unknown"},"doc://Math/documentation/Math/MathUnit":{"role":"symbol","kind":"symbol","url":"\/documentation\/math\/mathunit","type":"topic","identifier":"doc:\/\/Math\/documentation\/Math\/MathUnit","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"text":"MathUnit","kind":"identifier"}],"title":"MathUnit","abstract":[{"text":"A unit of measurement, such as a meter, a second, or a US dollar.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"MathUnit"}]},"doc://Math/documentation/Math":{"title":"Math","identifier":"doc:\/\/Math\/documentation\/Math","abstract":[{"text":"Perform type-safe dimensional analysis and unit conversion in your Swift app.","type":"text"}],"kind":"symbol","type":"topic","role":"collection","url":"\/documentation\/math"},"doc://Math/documentation/Math/MathDimension/length":{"abstract":[{"type":"text","text":"The compile-time dimension type representing length."}],"kind":"symbol","role":"symbol","navigatorTitle":[{"text":"length","kind":"identifier"}],"title":"MathDimension.length","url":"\/documentation\/math\/mathdimension\/length","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"length","kind":"identifier"}],"identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension\/length","type":"topic"},"doc://Math/documentation/Math/CustomDimensions":{"abstract":[{"type":"text","text":"Extend "},{"type":"codeVoice","code":"Math"},{"type":"text","text":" with your own physical dimensions and units—currency, points, gameplay metrics, or anything else your app measures."}],"role":"article","kind":"article","identifier":"doc:\/\/Math\/documentation\/Math\/CustomDimensions","url":"\/documentation\/math\/customdimensions","title":"Custom Dimensions and Units","type":"topic"},"doc://Math/documentation/Math/MathDimension":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"MathDimension"}],"url":"\/documentation\/math\/mathdimension","title":"MathDimension","identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"A namespace containing type-level structures for compile-time physical dimension verification."}],"navigatorTitle":[{"text":"MathDimension","kind":"identifier"}],"type":"topic"},"doc://Math/documentation/Math/Units":{"role":"symbol","identifier":"doc:\/\/Math\/documentation\/Math\/Units","navigatorTitle":[{"kind":"identifier","text":"Units"}],"url":"\/documentation\/math\/units","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"A namespace of ready-made units for every dimension in the framework."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Units"}],"title":"Units"}}}