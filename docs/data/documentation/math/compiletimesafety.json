{"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"Use generic constraints to make sure your APIs only ever receive the right kind of quantity.","type":"text"}],"variants":[{"paths":["\/documentation\/math\/compiletimesafety"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"metadata":{"modules":[{"name":"Math"}],"roleHeading":"Article","role":"article","title":"Compile-Time Dimension Type Safety"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Math\/documentation\/Math\/CompileTimeSafety"},"seeAlsoSections":[{"anchor":"Extending-the-Framework","title":"Extending the Framework","identifiers":["doc:\/\/Math\/documentation\/Math\/CustomDimensions"],"generated":true}],"hierarchy":{"paths":[["doc:\/\/Math\/documentation\/Math"]]},"kind":"article","primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"inlineContent":[{"text":"Every ","type":"text"},{"identifier":"doc:\/\/Math\/documentation\/Math\/MathUnit","isActive":true,"type":"reference"},{"text":" carries a compile-time dimension type through its","type":"text"},{"text":" ","type":"text"},{"code":"Dimension","type":"codeVoice"},{"text":" associated type. That type is a ","type":"text"},{"identifier":"doc:\/\/Math\/documentation\/Math\/DimensionProtocol","isActive":true,"type":"reference"},{"text":"-conforming","type":"text"},{"text":" ","type":"text"},{"text":"struct from the ","type":"text"},{"identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension","isActive":true,"type":"reference"},{"text":" namespace, such as ","type":"text"},{"identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension\/length","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"or ","type":"text"},{"identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension\/time","isActive":true,"type":"reference"},{"text":". Because the compiler can see this type, it can","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"reject dimension mismatches "},{"inlineContent":[{"text":"when you build your app","type":"text"}],"type":"emphasis"},{"text":" instead of when it runs.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Historically, dimensions were only checked at runtime. With compile-time","type":"text"},{"text":" ","type":"text"},{"text":"constraints, a function that declares ","type":"text"},{"inlineContent":[{"text":"“only lengths, please”","type":"text"}],"type":"emphasis"},{"type":"text","text":" is enforced by"},{"type":"text","text":" "},{"type":"text","text":"the Swift type checker."}]},{"type":"heading","level":3,"text":"Constrain a Generic to a Dimension","anchor":"Constrain-a-Generic-to-a-Dimension"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Write a generic function or protocol requirement over a unit type "},{"type":"codeVoice","code":"U: MathUnit"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"then constrain "},{"type":"codeVoice","code":"U.Dimension"},{"type":"text","text":" with a "},{"type":"codeVoice","code":"where"},{"type":"text","text":" clause:"}]},{"syntax":"swift","type":"codeListing","code":["import Math","","\/\/ This method only accepts quantities of length.","func measureDistance<U: MathUnit>(_ distance: Quantity<U>) -> Bool","where U.Dimension == MathDimension.length {","    distance.value > 0","}"]},{"type":"heading","text":"Passing the Correct Units","level":3,"anchor":"Passing-the-Correct-Units"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The built-in units in "},{"identifier":"doc:\/\/Math\/documentation\/Math\/Units","isActive":true,"type":"reference"},{"type":"text","text":" are already parameterized by their dimension."},{"type":"text","text":" "},{"type":"text","text":"Passing a length unit compiles cleanly:"}]},{"syntax":"swift","type":"codeListing","code":["let radius = Quantity(value: 500, unit: Units.meter)","measureDistance(radius) \/\/ Compiles perfectly! ✅"]},{"level":3,"anchor":"Preventing-Mismatched-Units","type":"heading","text":"Preventing Mismatched Units"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Passing a quantity of a different dimension is a compile-time error:"}]},{"code":["let timeLimit = Quantity(value: 30, unit: Units.minute)","measureDistance(timeLimit) \/\/ ✗ ERROR: 'time' is not 'length'"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":3,"text":"Runtime Checks for Dynamic Dimensions","anchor":"Runtime-Checks-for-Dynamic-Dimensions"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Not every quantity has a static dimension. Custom dimensions created at runtime"},{"type":"text","text":" "},{"type":"text","text":"(see "},{"identifier":"doc:\/\/Math\/documentation\/Math\/CustomDimensions","isActive":true,"type":"reference"},{"type":"text","text":") use "},{"identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension\/unknown","isActive":true,"type":"reference"},{"type":"text","text":" as their type-level"},{"type":"text","text":" "},{"type":"text","text":"parameter. For those, the compiler can’t help—so "},{"identifier":"doc:\/\/Math\/documentation\/Math","isActive":true,"type":"reference"},{"type":"text","text":" keeps its runtime"},{"type":"text","text":" "},{"type":"text","text":"safety net. Operations that combine quantities verify that dimensions match and"},{"type":"text","text":" "},{"type":"text","text":"raise a runtime "},{"type":"codeVoice","code":"preconditionFailure"},{"type":"text","text":" if they don’t:"}]},{"code":["let usdDimension = PhysicalDimension(exponents: [\"USD\": 1])","let usdUnit = NamedUnit<MathDimension.unknown>(","    symbol: \"$\", dimension: usdDimension, converter: LinearConverter(coefficient: 1.0)",")","","let userDimension = PhysicalDimension(exponents: [\"user\": 1])","let userUnit = NamedUnit<MathDimension.unknown>(","    symbol: \"user\", dimension: userDimension, converter: LinearConverter(coefficient: 1.0)",")","","\/\/ Traps at runtime: USD ≠ users","let revenue = Quantity(value: 100, unit: usdUnit) + Quantity(value: 3, unit: userUnit)"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":3,"anchor":"Applying-Constraints-at-the-Protocol-Level","text":"Applying Constraints at the Protocol Level"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can attach the same constraint to a protocol so every conformer enforces it:"}]},{"code":["protocol DistanceMeasurer {","    func measure<U: MathUnit>(_ distance: Quantity<U>) -> Double","    where U.Dimension == MathDimension.length","}","","\/\/ All built-in length units satisfy this automatically:","struct RangeFinder: DistanceMeasurer {","    func measure<U: MathUnit>(_ distance: Quantity<U>) -> Double","    where U.Dimension == MathDimension.length {","        distance.converted(to: Units.meter).value","    }","}","","let width = Quantity(value: 10, unit: Units.foot)","RangeFinder().measure(width) \/\/ 3.048"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":3,"anchor":"Whats-Next","text":"What’s Next?"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"See the full list of compile-time dimensions in "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Combine compile-time safety with your own domain in "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/CustomDimensions"},{"type":"text","text":"."}]}]}]}]}],"references":{"doc://Math/documentation/Math":{"title":"Math","abstract":[{"type":"text","text":"Perform type-safe dimensional analysis and unit conversion in your Swift app."}],"kind":"symbol","identifier":"doc:\/\/Math\/documentation\/Math","type":"topic","role":"collection","url":"\/documentation\/math"},"doc://