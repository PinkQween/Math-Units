{"identifier":{"url":"doc:\/\/Math\/documentation\/Math\/CompileTimeSafety","interfaceLanguage":"swift"},"seeAlsoSections":[{"identifiers":["doc:\/\/Math\/documentation\/Math\/CustomDimensions"],"anchor":"Extending-the-Framework","title":"Extending the Framework","generated":true}],"abstract":[{"text":"Use generic constraints to make sure your APIs only ever receive the right kind of quantity.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/Math\/documentation\/Math"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/math\/compiletimesafety"]}],"metadata":{"modules":[{"name":"Math"}],"roleHeading":"Article","title":"Compile-Time Dimension Type Safety","role":"article"},"kind":"article","primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every "},{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/MathUnit","isActive":true},{"type":"text","text":" carries a compile-time dimension type through its"},{"type":"text","text":" "},{"type":"codeVoice","code":"Dimension"},{"type":"text","text":" associated type. That type is a "},{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/DimensionProtocol","isActive":true},{"type":"text","text":"-conforming"},{"type":"text","text":" "},{"type":"text","text":"struct from the "},{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension","isActive":true},{"type":"text","text":" namespace, such as "},{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension\/length","isActive":true},{"type":"text","text":" "},{"type":"text","text":"or "},{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension\/time","isActive":true},{"type":"text","text":". Because the compiler can see this type, it can"},{"type":"text","text":" "},{"type":"text","text":"reject dimension mismatches "},{"type":"emphasis","inlineContent":[{"text":"when you build your app","type":"text"}]},{"type":"text","text":" instead of when it runs."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Historically, dimensions were only checked at runtime. With compile-time"},{"type":"text","text":" "},{"type":"text","text":"constraints, a function that declares "},{"type":"emphasis","inlineContent":[{"text":"“only lengths, please”","type":"text"}]},{"type":"text","text":" is enforced by"},{"type":"text","text":" "},{"type":"text","text":"the Swift type checker."}]},{"type":"heading","text":"Constrain a Generic to a Dimension","level":3,"anchor":"Constrain-a-Generic-to-a-Dimension"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Write a generic function or protocol requirement over a unit type "},{"type":"codeVoice","code":"U: MathUnit"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"then constrain "},{"type":"codeVoice","code":"U.Dimension"},{"type":"text","text":" with a "},{"type":"codeVoice","code":"where"},{"type":"text","text":" clause:"}]},{"type":"codeListing","syntax":"swift","code":["import Math","","\/\/ This method only accepts quantities of length.","func measureDistance<U: MathUnit>(_ distance: Quantity<U>) -> Bool","where U.Dimension == MathDimension.length {","    distance.value > 0","}"]},{"type":"heading","text":"Passing the Correct Units","level":3,"anchor":"Passing-the-Correct-Units"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The built-in units in "},{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/Units","isActive":true},{"type":"text","text":" are already parameterized by their dimension."},{"type":"text","text":" "},{"type":"text","text":"Passing a length unit compiles cleanly:"}]},{"type":"codeListing","syntax":"swift","code":["let radius = Quantity(value: 500, unit: Units.meter)","measureDistance(radius) \/\/ Compiles perfectly! ✅"]},{"type":"heading","text":"Preventing Mismatched Units","level":3,"anchor":"Preventing-Mismatched-Units"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Passing a quantity of a different dimension is a compile-time error:"}]},{"type":"codeListing","syntax":"swift","code":["let timeLimit = Quantity(value: 30, unit: Units.minute)","measureDistance(timeLimit) \/\/ ✗ ERROR: 'time' is not 'length'"]},{"type":"heading","text":"Runtime Checks for Dynamic Dimensions","level":3,"anchor":"Runtime-Checks-for-Dynamic-Dimensions"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Not every quantity has a static dimension. Custom dimensions created at runtime"},{"type":"text","text":" "},{"type":"text","text":"(see "},{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/CustomDimensions","isActive":true},{"type":"text","text":") use "},{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension\/unknown","isActive":true},{"type":"text","text":" as their type-level"},{"type":"text","text":" "},{"type":"text","text":"parameter. For those, the compiler can’t help—so "},{"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math","isActive":true},{"type":"text","text":" keeps its runtime"},{"type":"text","text":" "},{"type":"text","text":"safety net. Operations that combine quantities verify that dimensions match and"},{"type":"text","text":" "},{"type":"text","text":"raise a runtime "},{"type":"codeVoice","code":"preconditionFailure"},{"type":"text","text":" if they don’t:"}]},{"type":"codeListing","syntax":"swift","code":["let usdDimension = PhysicalDimension(exponents: [\"USD\": 1])","let usdUnit = NamedUnit<MathDimension.unknown>(","    symbol: \"$\", dimension: usdDimension, converter: LinearConverter(coefficient: 1.0)",")","","let userDimension = PhysicalDimension(exponents: [\"user\": 1])","let userUnit = NamedUnit<MathDimension.unknown>(","    symbol: \"user\", dimension: userDimension, converter: LinearConverter(coefficient: 1.0)",")","","\/\/ Traps at runtime: USD ≠ users","let revenue = Quantity(value: 100, unit: usdUnit) + Quantity(value: 3, unit: userUnit)"]},{"type":"heading","text":"Applying Constraints at the Protocol Level","level":3,"anchor":"Applying-Constraints-at-the-Protocol-Level"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can attach the same constraint to a protocol so every conformer enforces it:"}]},{"type":"codeListing","syntax":"swift","code":["protocol DistanceMeasurer {","    func measure<U: MathUnit>(_ distance: Quantity<U>) -> Double","    where U.Dimension == MathDimension.length","}","","\/\/ All built-in length units satisfy this automatically:","struct RangeFinder: DistanceMeasurer {","    func measure<U: MathUnit>(_ distance: Quantity<U>) -> Double","    where U.Dimension == MathDimension.length {","        distance.converted(to: Units.meter).value","    }","}","","let width = Quantity(value: 10, unit: Units.foot)","RangeFinder().measure(width) \/\/ 3.048"]},{"type":"heading","text":"What’s Next?","level":3,"anchor":"Whats-Next"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"See the full list of compile-time dimensions in ","type":"text"},{"identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Combine compile-time safety with your own domain in ","type":"text"},{"identifier":"doc:\/\/Math\/documentation\/Math\/CustomDimensions","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]}]}],"kind":"content"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"references":{"doc://Math/documentation/Math/MathDimension/length":{"type":"topic","kind":"symbol","title":"MathDimension.length","url":"\/documentation\/math\/mathdimension\/length","identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension\/length","abstract":[{"text":"The compile-time dimension type representing length.","type":"text"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"length","kind":"identifier"}],"navigatorTitle":[{"text":"length","kind":"identifier"}]},"doc://Math/documentation/Math/MathDimension/unknown":{"navigatorTitle":[{"text":"unknown","kind":"identifier"}],"abstract":[{"type":"text","text":"The compile-time dimension type used for dimensions that don’t have a"},{"type":"text","text":" "},{"type":"text","text":"static type, such as custom dimensions created at runtime."}],"identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension\/unknown","url":"\/documentation\/math\/mathdimension\/unknown","type":"topic","kind":"symbol","title":"MathDimension.unknown","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"unknown","kind":"identifier"}]},"doc://Math/documentation/Math/DimensionProtocol":{"type":"topic","kind":"symbol","role":"symbol","title":"DimensionProtocol","url":"\/documentation\/math\/dimensionprotocol","navigatorTitle":[{"text":"DimensionProtocol","kind":"identifier"}],"abstract":[{"type":"text","text":"A protocol representing a type-level identifier for a physical dimension."}],"identifier":"doc:\/\/Math\/documentation\/Math\/DimensionProtocol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DimensionProtocol","kind":"identifier"}]},"doc://Math/documentation/Math/MathUnit":{"identifier":"doc:\/\/Math\/documentation\/Math\/MathUnit","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MathUnit","kind":"identifier"}],"abstract":[{"type":"text","text":"A unit of measurement, such as a meter, a second, or a US dollar."}],"type":"topic","role":"symbol","title":"MathUnit","kind":"symbol","navigatorTitle":[{"text":"MathUnit","kind":"identifier"}],"url":"\/documentation\/math\/mathunit"},"doc://Math/documentation/Math/Units":{"abstract":[{"type":"text","text":"A namespace of ready-made units for every dimension in the framework."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Units","kind":"identifier"}],"navigatorTitle":[{"text":"Units","kind":"identifier"}],"url":"\/documentation\/math\/units","kind":"symbol","title":"Units","identifier":"doc:\/\/Math\/documentation\/Math\/Units","type":"topic"},"doc://Math/documentation/Math/MathDimension":{"identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension","title":"MathDimension","url":"\/documentation\/math\/mathdimension","abstract":[{"text":"A namespace containing type-level structures for compile-time physical dimension verification.","type":"text"}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"MathDimension","kind":"identifier"}],"role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MathDimension","kind":"identifier"}]},"doc://Math/documentation/Math/MathDimension/time":{"navigatorTitle":[{"text":"time","kind":"identifier"}],"abstract":[{"type":"text","text":"The compile-time dimension type representing time."}],"identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension\/time","url":"\/documentation\/math\/mathdimension\/time","type":"topic","kind":"symbol","title":"MathDimension.time","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"time","kind":"identifier"}]},"doc://Math/documentation/Math":{"type":"topic","title":"Math","kind":"symbol","url":"\/documentation\/math","identifier":"doc:\/\/Math\/documentation\/Math","abstract":[{"text":"Perform type-safe dimensional analysis and unit conversion in your Swift app.","type":"text"}],"role":"collection"},"doc://Math/documentation/Math/CustomDimensions":{"identifier":"doc:\/\/Math\/documentation\/Math\/CustomDimensions","kind":"article","abstract":[{"type":"text","text":"Extend "},{"type":"codeVoice","code":"Math"},{"type":"text","text":" with your own physical dimension