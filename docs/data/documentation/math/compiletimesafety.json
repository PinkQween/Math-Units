{"seeAlsoSections":[{"generated":true,"anchor":"Extending-the-Framework","title":"Extending the Framework","identifiers":["doc:\/\/Math\/documentation\/Math\/CustomDimensions"]}],"kind":"article","sections":[],"metadata":{"modules":[{"name":"Math"}],"roleHeading":"Article","role":"article","title":"Compile-Time Dimension Type Safety"},"hierarchy":{"paths":[["doc:\/\/Math\/documentation\/Math"]]},"identifier":{"url":"doc:\/\/Math\/documentation\/Math\/CompileTimeSafety","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"Every ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/MathUnit","type":"reference"},{"text":" carries a compile-time dimension type through its","type":"text"},{"text":" ","type":"text"},{"code":"Dimension","type":"codeVoice"},{"text":" associated type. That type is a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/DimensionProtocol","type":"reference"},{"text":"-conforming","type":"text"},{"text":" ","type":"text"},{"text":"struct from the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension","type":"reference"},{"text":" namespace, such as ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension\/length","type":"reference"},{"text":" ","type":"text"},{"text":"or ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension\/time","type":"reference"},{"text":". Because the compiler can see this type, it can","type":"text"},{"text":" ","type":"text"},{"text":"reject dimension mismatches ","type":"text"},{"inlineContent":[{"text":"when you build your app","type":"text"}],"type":"emphasis"},{"text":" instead of when it runs.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Historically, dimensions were only checked at runtime. With compile-time","type":"text"},{"text":" ","type":"text"},{"text":"constraints, a function that declares ","type":"text"},{"inlineContent":[{"text":"“only lengths, please”","type":"text"}],"type":"emphasis"},{"text":" is enforced by","type":"text"},{"text":" ","type":"text"},{"text":"the Swift type checker.","type":"text"}],"type":"paragraph"},{"text":"Constrain a Generic to a Dimension","level":3,"anchor":"Constrain-a-Generic-to-a-Dimension","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Write a generic function or protocol requirement over a unit type ","type":"text"},{"code":"U: MathUnit","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"then constrain ","type":"text"},{"code":"U.Dimension","type":"codeVoice"},{"text":" with a ","type":"text"},{"code":"where","type":"codeVoice"},{"text":" clause:","type":"text"}]},{"code":["import Math","","\/\/ This method only accepts quantities of length.","func measureDistance<U: MathUnit>(_ distance: Quantity<U>) -> Bool","where U.Dimension == MathDimension.length {","    distance.value > 0","}"],"type":"codeListing","syntax":"swift"},{"text":"Passing the Correct Units","type":"heading","anchor":"Passing-the-Correct-Units","level":3},{"type":"paragraph","inlineContent":[{"text":"The built-in units in ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/Units"},{"text":" are already parameterized by their dimension.","type":"text"},{"text":" ","type":"text"},{"text":"Passing a length unit compiles cleanly:","type":"text"}]},{"code":["let radius = Quantity(value: 500, unit: Units.meter)","measureDistance(radius) \/\/ Compiles perfectly! ✅"],"type":"codeListing","syntax":"swift"},{"text":"Preventing Mismatched Units","type":"heading","anchor":"Preventing-Mismatched-Units","level":3},{"type":"paragraph","inlineContent":[{"text":"Passing a quantity of a different dimension is a compile-time error:","type":"text"}]},{"code":["let timeLimit = Quantity(value: 30, unit: Units.minute)","measureDistance(timeLimit) \/\/ ✗ ERROR: 'time' is not 'length'"],"type":"codeListing","syntax":"swift"},{"text":"Runtime Checks for Dynamic Dimensions","type":"heading","anchor":"Runtime-Checks-for-Dynamic-Dimensions","level":3},{"type":"paragraph","inlineContent":[{"text":"Not every quantity has a static dimension. Custom dimensions created at runtime","type":"text"},{"text":" ","type":"text"},{"text":"(see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/CustomDimensions"},{"text":") use ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension\/unknown"},{"text":" as their type-level","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"parameter. For those, the compiler can’t help—so "},{"identifier":"doc:\/\/Math\/documentation\/Math","type":"reference","isActive":true},{"type":"text","text":" keeps its runtime"},{"type":"text","text":" "},{"text":"safety net. Operations that combine quantities verify that dimensions match and","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"raise a runtime "},{"type":"codeVoice","code":"preconditionFailure"},{"type":"text","text":" if they don’t:"}]},{"code":["let usdDimension = PhysicalDimension(exponents: [\"USD\": 1])","let usdUnit = NamedUnit<MathDimension.unknown>(","    symbol: \"$\", dimension: usdDimension, converter: LinearConverter(coefficient: 1.0)",")","","let userDimension = PhysicalDimension(exponents: [\"user\": 1])","let userUnit = NamedUnit<MathDimension.unknown>(","    symbol: \"user\", dimension: userDimension, converter: LinearConverter(coefficient: 1.0)",")","","\/\/ Traps at runtime: USD ≠ users","let revenue = Quantity(value: 100, unit: usdUnit) + Quantity(value: 3, unit: userUnit)"],"syntax":"swift","type":"codeListing"},{"text":"Applying Constraints at the Protocol Level","level":3,"anchor":"Applying-Constraints-at-the-Protocol-Level","type":"heading"},{"inlineContent":[{"text":"You can attach the same constraint to a protocol so every conformer enforces it:","type":"text"}],"type":"paragraph"},{"code":["protocol DistanceMeasurer {","    func measure<U: MathUnit>(_ distance: Quantity<U>) -> Double","    where U.Dimension == MathDimension.length","}","","\/\/ All built-in length units satisfy this automatically:","struct RangeFinder: DistanceMeasurer {","    func measure<U: MathUnit>(_ distance: Quantity<U>) -> Double","    where U.Dimension == MathDimension.length {","        distance.converted(to: Units.meter).value","    }","}","","let width = Quantity(value: 10, unit: Units.foot)","RangeFinder().measure(width) \/\/ 3.048"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"What’s Next?","anchor":"Whats-Next","type":"heading"},{"items":[{"content":[{"inlineContent":[{"text":"See the full list of compile-time dimensions in ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Combine compile-time safety with your own domain in ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Math\/documentation\/Math\/CustomDimensions"},{"text":".","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/math\/compiletimesafety"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"Use generic constraints to make sure your APIs only ever receive the right kind of quantity."}],"references":{"doc://Math/documentation/Math/MathDimension":{"identifier":"doc:\/\/Math\/documentation\/Math\/MathDimension","abstract":[{"text":"A namespace containing type-level structures for compile-time physical dimension verification.","type":"text"}],"type":"topic","url":"\/documentation\/math\/mathdimension